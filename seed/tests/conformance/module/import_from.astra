// `import` / `from` are the module declarations of research/010 §12.1:
//   ImportStmt ::= "import" ImportPath ("as" Identifier)?
//                | "from" ImportPath "import" ImportItem ("," ImportItem)*
//   ImportPath ::= Identifier ("." Identifier)*
//   ImportItem ::= Identifier ("as" Identifier)?
//
// The seed parses them and then discards them, exactly like `use`: the driver
// compiles exactly one file, so module resolution is deliberately not its job
// (research/011 §5.2). Declaring the surface anyway is what keeps the seed and
// the Zig frontend on the same grammar — the parity gate in AGENTS.md — and
// this case is what holds the seed side of it in place.
//
// EXPECT: 7
import std.io
import geometry.mesh as mesh
from geometry.vector import Vec2, add as sum
from std.os.linux import write

let x = 7
print(x);
