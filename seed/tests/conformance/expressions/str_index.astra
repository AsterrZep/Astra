// Indexing a string (DEC-013, research/028 PR1): `s[i]` reads byte i as a
// one-byte string, so it concatenates and compares like any other string —
// the primitive a self-hosted lexer uses to walk its source.
// EXPECT: h
// EXPECT: ello
// EXPECT: true
fn main() {
    let s = "hello"
    print(s[0])
    let mut w = ""
    let mut i: i64 = 1
    while i < len(s) {
        w = w + s[i]
        i = i + 1
    }
    print(w)
    print(s[4] == "o")
}
