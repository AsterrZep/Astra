// DEC-026 §4 (R4 nil-red) — S1 is intraprocedural, so a use of a moved
// GLOBAL from another function slips past the static net on purpose: the
// runtime must see the binding as nil. This is the observable half of the
// move (module-level `transfer(g)` runs before main, then peek() indexes
// the invalidated global).
// EXPECT-RUNTIME-ERROR: cannot index nil
let mut g = [1, 2, 3];
transfer(g);

fn peek() {
    print(g[0]);
}

fn main() {
    peek();
}
