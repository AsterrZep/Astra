// Phase 2.3 step 3-4 (both compilers): static method dispatch. `x.m()` is
// resolved at compile time in the receiver's method table: the method runs as
// the global `Type.method`, the receiver binds to `self`, inherent impls beat
// trait impls on a name clash, and chains work because a method's return type
// feeds the next lookup.
// EXPECT: 40
// EXPECT: 42
// EXPECT: inherent
// EXPECT: trait
// EXPECT: red
// EXPECT: 42
// EXPECT: 39

struct Point {
    x: i32
    y: i32
}

trait Show {
    fn show(self) -> string
    fn label(self) -> string
}

impl Show for Point {
    fn show(self) -> string {
        return "trait"
    }
    fn label(self) -> string {
        return "trait"
    }
}

impl Point {
    fn get_x(self) -> i32 {
        self.x
    }
    fn add(self, n: i32) -> i32 {
        self.x + n
    }
    // Declared in both the trait impl and the inherent impl: the inherent
    // entry wins regardless of declaration order.
    fn show(self) -> string {
        return "inherent"
    }
    fn moved(self, dx: i32) -> Point {
        Point { x: self.x + dx, y: self.y }
    }
}

enum Color {
    Red
    Green
}

impl Color {
    fn name(self) -> string {
        return match self {
            Color.Red => "red",
            Color.Green => "green",
        };
    }
}

fn distance_x(a: Point, b: Point) -> i32 {
    b.get_x() - a.get_x()
}

fn main() {
    let p = Point { x: 40, y: 2 }
    print(p.get_x())
    print(p.add(2))
    print(p.show())
    print(p.label())
    print(Color.Red.name())
    print(p.moved(2).get_x())
    print(distance_x(Point { x: 1, y: 0 }, p))
}
