// Closures: lambdas capture free variables from the enclosing frame by
// value (ARCHITECTURE.md 30.5).
// EXPECT: 6
// EXPECT: 111
// EXPECT: 50
// EXPECT: 30
// EXPECT: 6
fn outer() -> i32 {
    let n = 5
    let f = |x: i32| -> i32 { x + n }
    return f(1)
}

fn chain() -> i32 {
    let a = 1
    let outer_l = |x: i32| -> i32 {
        let inner = |y: i32| -> i32 { x + y + a }
        return inner(10)
    }
    return outer_l(100)
}

let g = 42
let top = |x: i32| -> i32 { x + g }

// The env must outlive the frame that produced it: the closure is stored
// in a global and called after `store` returned, so a borrowed frame slot
// would be use-after-free here.
let mut saved = |x: i32| -> i32 { x }

fn store() {
    let base = 7
    saved = |x: i32| -> i32 { x + base }
}

// By value = snapshot at build time (audit §7.11): reassigning the captured
// binding AFTER the closure exists must not reach into the closure, which is
// what separates by-value from by-reference capture (f(1) stays 5+1=6, not 10+1).
fn by_value() -> i32 {
    let mut n = 5
    let f = |x: i32| -> i32 { x + n }
    n = 10
    return f(1)
}

fn main() {
    print(outer())
    print(chain())
    print(top(8))
    store()
    print(saved(23))
    print(by_value())
}
