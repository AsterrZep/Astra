// Loop-local cells are runtime residue only on the paths that created them.
// The loop-exit ensure (and the break reconcile stubs) normalise every exit
// to the modelled height, so a value construct after the loop still finds
// its receiver where the emitter said it would (audit §4.7).
// EXPECT: 7
// EXPECT: 2
// EXPECT: 0
// EXPECT: 3
// EXPECT: 9
fn main() {
    let mut i = 0

    // Zero-iteration body: the `let t` cell never exists at runtime.
    while false { let t = 9 }
    print(match i { _ => 7 })

    // break from inside a branch that declared a local: the jump skips the
    // branch close, so the exit stub must drop the dead cell.
    while true { if i > 1 { let t = 5; break } i = i + 1 }
    print(match i { _ => i })

    // Natural exit with body locals (two iterations of residue).
    let mut acc = 0
    while i < 4 { let t = 1; acc = acc + t; i = i + 1 }
    print(match acc { _ => acc - 2 })

    // for-loop: prologue cells (for_i/for_arr/var) always exist; the body
    // cell does not run zero times here, but the match follows the ensure.
    let mut s = 0
    for x in 1..3 { s = s + x }
    print(match s { _ => s })

    print(if true { let b = 9; b } else { 0 })
}
