// A scalar target (int/float/string, and anything else without an
// enumerable pattern space) must carry a catch-all: Astra-0 has no range
// patterns, so without `_` the match fell through at run time and yielded
// a nil that lied under the promised type (audit §3.8 — ARCHITECTURE.md
// §11.3 "compile error por defecto", research/004 strict model).
// EXPECT-ERROR: non-exhaustive match: missing '_' arm
fn main() {
    let x = 5
    print(match x { 1 => 10, 2 => 20 })
}
