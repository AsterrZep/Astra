// Initialising a field the struct does not declare must be a compile error
// EXPECT-ERROR: struct 'Point' has no field 'z'
// EXPECT-ERROR-FIRST: tests/conformance/ui/struct_unknown_field.astra:10:13: error: struct 'Point' has no field 'z'
struct Point {
    x: i32
    y: i32
}

fn main() {
    let p = Point { x: 1, y: 2, z: 3 };
    print(p.x);
}
