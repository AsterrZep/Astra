// The mangled instance name must fit its fixed 512-byte buffer. A binding
// tuple whose spelling overflows it is rejected: a truncated name could
// collide with another truncated name and silently merge two different
// instances (Phase 2.4 audit). The long struct name keeps the AST shallow
// so the failure is the mangle, not nesting depth.
// EXPECT-ERROR: generic instance name for 'idt' is too long
fn idt<T>(x: T) -> T {
    x
}
struct  {
    v: i32
}
idt( { v: 1 })
