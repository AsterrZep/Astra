// Pattern binding with wrong type should error
// EXPECT-ERROR: type mismatch: variable 'n' declared as string but initialized with i32
enum Color {
    Rgb(i32, i32, i32)
}

fn main() {
    let c = Rgb(1, 2, 3);
    match c {
        Color.Rgb(x, y, z) => {
            let n: string = x;
        }
    }
}
