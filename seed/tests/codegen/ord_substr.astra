// C round-trip for ord/substr (DEC-018): the generic builtin dispatch
// (fun(args, argc)) must reach astra_builtin_ord / astra_builtin_substr, and
// a lexeme taken with substr must compare, concatenate and re-read through
// ord exactly like it does on the VM.
// EXPECT: 65
// EXPECT: ell
// EXPECT: true
// EXPECT: lex=ell
// EXPECT: 101
fn main() {
    print(ord("A"))
    let s = "hello"
    print(substr(s, 1, 3))
    print(substr(s, 0, len(s)) == s)
    print("lex=" + substr(s, 1, 3))
    print(ord(substr(s, 1, 1)))
}
