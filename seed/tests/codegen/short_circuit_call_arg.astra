// C-backend twin of conformance/expressions/short_circuit_call_arg.astra:
// the short-circuit `&&`/`||` double-push bug (first branch CONST falls
// through to the second, CALL reads the wrong slot) is fixed at the
// bytecode level, so the emitted C inherits it; this fixture makes the
// sweep_emit_c gate and the LLVM parity gate pin the behaviour.
fn pos(n: i32) -> bool {
    n > 0
}

fn main() {
    let a = true
    let b = false

    print(a || b)
// EXPECT: true
    print(b || a)
// EXPECT: true
    print(pos(1) || pos(-1))
// EXPECT: true

    print(a && b)
// EXPECT: false
    print(b && a)
// EXPECT: false
    print(pos(-1) && pos(1))
// EXPECT: false

    let x = a || b
    print(x)
// EXPECT: true
    let y = a && b
    print(y)
// EXPECT: false
    if a && b { print(1) } else { print(2) }
// EXPECT: 2
    if a || b { print(3) } else { print(4) }
// EXPECT: 3
}
