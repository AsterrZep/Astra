// EXPECT: true
// EXPECT: false
// EXPECT: true
// EXPECT: false
// EXPECT: true
// EXPECT: true
//
// C backend twin of conformance/expressions/aggregate_equality.astra (S12).
// Before the fix every aggregate comparison in the generated program was false:
// astra_eq's switch fell through to `default: return astra_bool(0)` for arrays,
// structs and data-carrying variants, so the VM and the compiled program
// disagreed silently.
struct Pair {
    v: [i32]
    tag: string
}

enum Shape {
    Circle(i32)
    Rect(i32, i32)
}

fn main() {
    print([1, 2] == [1, 2])
    print([1, 2] == [1, 3])
    print([[1, 2], [3]] == [[1, 2], [3]])
    print(Pair { v: [1], tag: "a" } == Pair { v: [1], tag: "b" })
    print(Circle(1) == Circle(1))
    print(Rect(1, 2) == Rect(1, 2))
}
