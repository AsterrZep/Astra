// C backend twin of conformance/enums/match_guard_payload_stub.astra (audit
// §4.8/§4.11): the guard-false stub's POP carries the exact drop count and
// the guard-false edge lands on the stub in the VM, the C backend and the
// Zig mirror alike.
// EXPECT: 0
// EXPECT: 2
// EXPECT: 0
// EXPECT: 1
// EXPECT: 0
// EXPECT: 104
// EXPECT: 0
// EXPECT: 5
// EXPECT: 3

enum E { A B(i32) C(i32, i32) }

fn main() {
    // Variant payload binding, guard fails -> wildcard arm.
    let v1 = B(1)
    print(match v1 { E.B(n) if n > 1 => n, _ => 0 })

    // Variant payload binding, guard holds -> the arm runs.
    let v2 = B(2)
    print(match v2 { E.B(n) if n > 1 => n, _ => 0 })

    // Two payload bindings: the guard-false drop is both cells.
    let c1 = C(3, 7)
    print(match c1 { E.C(x, y) if x > y => 1, _ => 0 })
    let c2 = C(9, 2)
    print(match c2 { E.C(x, y) if x > y => 1, _ => 0 })

    // Builtin payload binding (Option), guard fails.
    let o1 = some(5)
    print(match o1 { some(x) if x > 9 => x, _ => 0 })

    // Chained builtin guards: the second arm's binding slot sits past the
    // frontier, so its drop covers the stale pad cell too.
    let o2 = some(4)
    print(match o2 { some(x) if x > 9 => x, some(y) if y > 1 => y + 100, _ => 0 })

    // Stale-pad chain across pattern kinds: variant guard, guarded plain
    // binding, variant arm, wildcard — every failed guard must hand the
    // next arm arm-entry height.
    let i = 1
    let e1 = B(1)
    print(match e1 { E.B(n) if n > 1 => n, m if i == 0 => 100, E.A => 50, _ => 0 })

    // Chained guarded variant arms.
    let b = B(5)
    print(match b { E.B(n) if n > 9 => n, E.B(k) if k > 1 => k, E.A => 50, _ => 0 })

    // Guarded plain binding, guard fails, wildcard arm.
    let s = 3
    print(match s { n if n > 9 => 1, _ => 3 })
}
