// parser.astra — parser de Astra-0 auto-hospedado, v1 (DEC-025).
// Lee parser_input.astra (read_file usa path RELATIVO: el gate fija el cwd)
// y emite UNA línea con el AST en s-expresión prefijo:
//   Node(kid1 kid2 ...)  ·  hojas con payload  FnDecl(main)  ·  hojas finas  Break
// El golden es parser.expected, generado con
//   astra-seed --dump-ast parser_input.astra | awk -f normalize_ast.awk
// (implementación independiente: el parser en C vs. éste).
//
// Alcance v2 (DEC-025 + DEC-028): fin de sentencia = ';' O cambio de línea
// O '}' O EOF (espejo del optional_semi del seed); 'else' exige la misma
// línea que el '}' del then; match (comas obligatorias entre brazos,
// guardas parseadas pero NO emitidas — el dump del seed las omite) con
// patrones literal/-unario/string/bool/or/wildcard/ruta calificada/
// binding/PatternVariantBind; items enum (Variant + Field payloads de un
// solo ident). Literales int decimal/string plano/bool, unary -/!,
// precedencia de 27 ops del seed, calls, index, paréntesis, array literals,
// const/fn/params/return-type, let(+mut, tipo opcional), assign,
// if/else/else-if, while, return, break. Sin lambdas, genéricos, campos,
// escapes de string ni operadores a fin de línea (el seed corta la
// sentencia en el NEWLINE — DEC-028 §1).

// ---------- estado del lexer ----------
let mut src = ""
let mut slen: i64 = 0
let mut pos: i64 = 0
let mut tk = ""        // IDENT | INT | STRING | KEYWORD | PUNCT | EOF
let mut tl = ""        // lexeme (STRING incluye las comillas)
let mut ntk = ""       // siguiente token (peek, sin consumir)
let mut ntl = ""
let mut has_look = false
let mut look_tk = ""
let mut look_tl = ""
let mut cur_line: i64 = 1   // línea del scanner (NEWLINE contados en el skip)
let mut nln: i64 = 1        // línea del token recién leído (lex_core)
let mut t_line: i64 = 1     // línea del token actual
let mut prev_line: i64 = 1  // línea del último token consumido
let mut look_line: i64 = 1
let mut no_struct_lit = false  // DEC-030: espejo del flag del seed (parser.c:1894)

fn is_space(c: string) -> bool {
    c == " " || c == "\t" || c == "\r" || c == "\n"
}

fn is_digit(c: string) -> bool {
    c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

fn is_alpha(c: string) -> bool {
    c == "_" || c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f" || c == "g" || c == "h" || c == "i" || c == "j" || c == "k" || c == "l" || c == "m" || c == "n" || c == "o" || c == "p" || c == "q" || c == "r" || c == "s" || c == "t" || c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z" || c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z"
}

fn is_word(c: string) -> bool {
    is_alpha(c) || is_digit(c)
}

fn is_kw(w: string) -> bool {
    w == "fn" || w == "let" || w == "mut" || w == "const" || w == "return" || w == "if" || w == "else" || w == "while" || w == "break" || w == "true" || w == "false" || w == "match" || w == "enum" || w == "struct" || w == "trait" || w == "impl" || w == "for" || w == "pub" || w == "use" || w == "import" || w == "from" || w == "as"
}

// lex_core: escanea UN token en ntk/ntl sin tocar tk/tl (permite peek).
fn lex_core() {
    let mut skipping = true;
    while skipping && pos < slen {
        let c = src[pos];
        if c == "\n" {
            // DEC-028: los NEWLINE se cuentan ANTES de saltarlos — la línea
            // del token es la que decide el fin de sentencia (stmt_end).
            cur_line = cur_line + 1;
            pos = pos + 1;
        } else if c == " " || c == "\t" || c == "\r" {
            pos = pos + 1;
        } else if c == "/" && pos + 1 < slen && src[pos + 1] == "/" {
            while pos < slen && src[pos] != "\n" {
                pos = pos + 1;
            }
        } else {
            skipping = false;
        }
    }
    nln = cur_line;
    if pos >= slen {
        ntk = "EOF";
        ntl = "";
        return;
    }
    let c = src[pos];
    if c == "\"" {
        let start = pos;
        pos = pos + 1;
        while pos < slen && src[pos] != "\"" {
            if src[pos] == "\\" {
                pos = pos + 1;
            }
            pos = pos + 1;
        }
        if pos < slen {
            pos = pos + 1;
        }
        ntk = "STRING";
        ntl = substr(src, start, pos - start);
        return;
    }
    if is_digit(c) {
        let start = pos;
        while pos < slen && is_digit(src[pos]) {
            pos = pos + 1;
        }
        ntk = "INT";
        ntl = substr(src, start, pos - start);
        return;
    }
    if is_alpha(c) {
        let start = pos;
        while pos < slen && is_word(src[pos]) {
            pos = pos + 1;
        }
        let w = substr(src, start, pos - start);
        ntl = w;
        if is_kw(w) {
            ntk = "KEYWORD";
        } else {
            ntk = "IDENT";
        }
        return;
    }
    let mut two = "";
    if pos + 1 < slen {
        two = substr(src, pos, 2);
    }
    if two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "->" || two == "=>" {
        ntk = "PUNCT";
        ntl = two;
        pos = pos + 2;
        return;
    }
    ntk = "PUNCT";
    ntl = c;
    pos = pos + 1;
}

fn advance() {
    if has_look {
        prev_line = t_line;
        tk = look_tk;
        tl = look_tl;
        t_line = look_line;
        has_look = false;
        return;
    }
    lex_core();
    prev_line = t_line;
    tk = ntk;
    tl = ntl;
    t_line = nln;
}

fn peek_kind() -> string {
    if !has_look {
        lex_core();
        look_tk = ntk;
        look_tl = ntl;
        look_line = nln;
        has_look = true;
    }
    look_tk
}

fn peek_lex() -> string {
    if !has_look {
        lex_core();
        look_tk = ntk;
        look_tl = ntl;
        look_line = nln;
        has_look = true;
    }
    look_tl
}

// ---------- utilidades de composición ----------
fn join2(a: string, b: string) -> string {
    // early returns: el if-expressions multilinea como cola de fn todavía no
    // tipa en los dos compiladores («if branches have different types»)
    if a == "" {
        return b;
    }
    if b == "" {
        return a;
    }
    a + " " + b
}

// attach("FnDecl(main)", "Param(a ...) Block(...)") inserta los kids antes
// del ÚLTIMO ')' del texto; sin ')' y con kids, abre uno nuevo.
fn attach(text: string, kids: string) -> string {
    if kids == "" {
        return text;
    }
    let mut p: i64 = -1;
    let mut i: i64 = len(text) - 1;
    while i >= 0 {
        if text[i] == ")" {
            p = i;
            i = -1;
        } else {
            i = i - 1;
        }
    }
    if p < 0 {
        return text + "(" + kids + ")";
    }
    return substr(text, 0, p) + " " + kids + substr(text, p, len(text) - p);
}

fn report_err(msg: string) {
    print("PARSE-ERROR: " + msg + " got '" + tl + "'");
}

fn expect_punct(w: string) {
    if tk == "PUNCT" && tl == w {
        advance();
        return;
    }
    report_err("expected '" + w + "'");
    advance();
}

// DEC-028: fin de sentencia como el optional_semi del seed — ';' O cambio
// de línea O '}' O EOF. El token actual (t_line) contra el último
// consumido (prev_line) decide si hubo NEWLINE entre medias.
fn stmt_end() {
    if tk == "PUNCT" && tl == ";" {
        advance();
        return;
    }
    if tk == "EOF" || (tk == "PUNCT" && tl == "}") {
        return;
    }
    if t_line != prev_line {
        return;
    }
    report_err("expected ';' or newline");
    advance();
}

// ---------- precedencia (tabla de --dump-operators) ----------
fn bp_of(op: string) -> i64 {
    if op == "||" {
        return 3;
    }
    if op == "&&" {
        return 4;
    }
    if op == "==" || op == "!=" {
        return 8;
    }
    if op == "<" || op == ">" || op == "<=" || op == ">=" {
        return 9;
    }
    if op == "+" || op == "-" {
        return 11;
    }
    if op == "*" || op == "/" || op == "%" {
        return 12;
    }
    0
}

// ---------- parser ----------
// DEC-030: ruta de módulo punteada — sólo IDENT tras cada '.' (una
// palabra clave tras el punto es error, espejo de ui/import_keyword_segment).
fn parse_path_text() -> string {
    if tk != "IDENT" {
        report_err("expected module path");
        advance();
        return "?";
    }
    let mut path = tl;
    advance();
    while tk == "PUNCT" && tl == "." {
        advance();
        if tk != "IDENT" {
            report_err("expected module path segment");
            advance();
            return path + ".?";
        }
        path = path + "." + tl;
        advance();
    }
    path
}

fn parse_type() -> string {
    if tk == "IDENT" {
        let t = "TypeIdent(" + tl + ")";
        advance();
        return t;
    }
    report_err("expected type");
    advance();
    "TypeIdent(?)"
}

fn parse_expr(min_bp: i64) -> string {
    let mut left = "";
    if tk == "PUNCT" && (tl == "-" || tl == "!") {
        let op = tl;
        advance();
        left = "UnaryOp(" + op + " " + parse_expr(13) + ")";
    } else {
        left = parse_primary();
    }
    // Postfix en ORDEN de fuente (v2: un solo loop — `Size.S`, `f(x).y`,
    // `a[i].z` en cualquier orden; los tres loops separados del v1 no
    // podian encadenarse entre si).
    let mut postfixing = true;
    while postfixing {
        if tk == "PUNCT" && tl == "." {
            advance();
            if tk != "IDENT" {
                report_err("expected field name after '.'");
                advance();
                left = "PARSE-ERROR";
            } else {
                left = attach("FieldAccess(" + tl + ")", left);
                advance();
            }
        } else if tk == "PUNCT" && tl == "(" {
            advance();
            let mut args = "";
            while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
                let a = parse_expr(1);
                args = join2(args, a);
                if tk == "PUNCT" && tl == "," {
                    advance();
                }
            }
            expect_punct(")");
            left = "Call(" + join2(left, args) + ")";
        } else if tk == "PUNCT" && tl == "[" {
            advance();
            let idx = parse_expr(1);
            expect_punct("]");
            left = "Index(" + join2(left, idx) + ")";
        } else {
            postfixing = false;
        }
    }
    while true {
        if tk != "PUNCT" {
            break;
        }
        let bp = bp_of(tl);
        if bp == 0 || bp < min_bp {
            break;
        }
        let op = tl;
        advance();
        let right = parse_expr(bp + 1);
        left = "BinaryOp(" + op + " " + left + " " + right + ")";
    }
    left
}

fn parse_primary() -> string {
    if tk == "INT" {
        let t = "IntLit(" + tl + ")";
        advance();
        return t;
    }
    if tk == "STRING" {
        let t = "StringLit(" + tl + ")";
        advance();
        return t;
    }
    if tk == "KEYWORD" && (tl == "true" || tl == "false") {
        let t = "BoolLit(" + tl + ")";
        advance();
        return t;
    }
    if tk == "KEYWORD" && tl == "match" {
        return parse_match();
    }
    if tk == "PUNCT" && (tl == "|" || tl == "||") {
        // DEC-029: en posición de expresión un '|' inicial SOLO puede ser
        // lambda (el '|' binario nunca abre expresión; el seed es igual).
        return parse_lambda();
    }
    if tk == "IDENT" {
        // DEC-030: `IDENT {` es struct literal salvo con el flag activo
        // (condiciones de if/while y target de match — el seed decide con
        // no_struct_lit, no con lookahead: parser.c:1894). Los argumentos
        // de llamada heredan el flag igual que en el seed.
        if !no_struct_lit && peek_kind() == "PUNCT" && peek_lex() == "{" {
            let name = tl;
            advance(); // consume el ident; tk ahora es '{'
            advance(); // consume '{'
            let mut fields = "";
            while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
                if tk != "IDENT" {
                    report_err("expected field name");
                    advance();
                    return "PARSE-ERROR";
                }
                let fname = tl;
                advance();
                expect_punct(":");
                let val = parse_expr(1);
                fields = join2(fields, attach("Field(" + fname + ")", val));
                if tk == "PUNCT" && tl == "," {
                    advance();
                }
            }
            expect_punct("}");
            return attach("StructLit(" + name + ")", fields);
        }
        let t = "Ident(" + tl + ")";
        advance();
        return t;
    }
    if tk == "PUNCT" && tl == "(" {
        // DEC-030: dentro de paréntesis los struct literals vuelven a ser
        // legales (el seed restablece el flag, parser.c:289).
        advance();
        let saved_nsl = no_struct_lit;
        no_struct_lit = false;
        let inner = parse_expr(1);
        no_struct_lit = saved_nsl;
        expect_punct(")");
        return inner;
    }
    if tk == "PUNCT" && tl == "[" {
        advance();
        let mut elems = "";
        let mut count: i64 = 0;
        while !(tk == "PUNCT" && tl == "]") && tk != "EOF" {
            let e = parse_expr(1);
            elems = join2(elems, e);
            count = count + 1;
            if tk == "PUNCT" && tl == "," {
                advance();
            }
        }
        expect_punct("]");
        return attach("ArrayLit(" + to_string(count) + ")", elems);
    }
    report_err("expected expression");
    advance();
    "PARSE-ERROR"
}

// DEC-029: lambda — |params| [-> type] { block }. El cuerpo DEBE ser
// bloque (el seed rechaza el cuerpo sin llaves). Los tipos de parámetro y
// la anotación -> type se parsean pero NO se emiten: el dump del seed
// imprime `Lambda [Param(name)]* [TypeIdent(ret)] Block` — el TypeIdent
// es SOLO la anotación de retorno (verificado; los tipos de parámetro no
// aparecen). Sin parámetros: `||` (token OR_OR, tratado como lista vacía)
// o `| |` (dos PUNCT) — el mismo loop cubre ambas grafías.
fn parse_lambda() -> string {
    let mut params = "";
    if tk == "PUNCT" && tl == "||" {
        advance();
    } else {
        advance(); // abre '|'
        while !(tk == "PUNCT" && tl == "|") && tk != "EOF" {
            if tk != "IDENT" {
                report_err("expected lambda parameter");
                advance();
                return "PARSE-ERROR";
            }
            params = join2(params, "Param(" + tl + ")");
            advance();
            if tk == "PUNCT" && tl == ":" {
                advance();
                let ptype = parse_type(); // descartada: el dump no la imprime
            }
            if tk == "PUNCT" && tl == "," {
                advance();
            }
        }
        expect_punct("|");
    }
    if tk == "PUNCT" && tl == "->" {
        advance();
        let rtype = parse_type(); // descartada salvo por el descarte mismo
        params = join2(params, rtype); // el dump SÍ imprime el ret como TypeIdent
    }
    if !(tk == "PUNCT" && tl == "{") {
        report_err("expected '{' for lambda body");
        return "PARSE-ERROR";
    }
    attach("Lambda", join2(params, parse_block()))
}

// DEC-028: una alternativa de patron (sin el '|'). La misma forma que la
// expresion para las rutas: Size.XS -> FieldAccess(XS Ident(Size)).
fn parse_pattern_alt() -> string {
    if tk == "PUNCT" && tl == "-" {
        advance();
        if tk == "INT" {
            let n = tl;
            advance();
            return attach("UnaryOp(-)", "IntLit(" + n + ")");
        }
        report_err("expected number after '-' in pattern");
        advance();
        return "PARSE-ERROR";
    }
    if tk == "INT" {
        let t = "IntLit(" + tl + ")";
        advance();
        return t;
    }
    if tk == "STRING" {
        let t = "StringLit(" + tl + ")";
        advance();
        return t;
    }
    if tk == "KEYWORD" && (tl == "true" || tl == "false") {
        let t = "BoolLit(" + tl + ")";
        advance();
        return t;
    }
    if tk == "IDENT" {
        if tl == "_" {
            advance();
            return "PatternWildcard";
        }
        let root = tl;
        advance();
        let mut node = "Ident(" + root + ")";
        let mut segs: i64 = 1;
        while tk == "PUNCT" && tl == "." {
            advance();
            if tk != "IDENT" {
                report_err("expected name after '.' in pattern");
                advance();
                return "PARSE-ERROR";
            }
            node = attach("FieldAccess(" + tl + ")", node);
            segs = segs + 1;
            advance();
        }
        if tk == "PUNCT" && tl == "(" {
            // payload de variante: Point.Pt(a, b) — DEC-008 exige la ruta
            // calificada; sin wildcard por campo (el seed lo rechaza).
            if segs < 2 {
                report_err("enum patterns must be qualified (Enum.Variant)");
            }
            advance();
            let mut binds = "";
            while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
                if tk != "IDENT" {
                    report_err("expected binding name");
                    advance();
                    return "PARSE-ERROR";
                }
                binds = join2(binds, "Bind(" + tl + ")");
                advance();
                if tk == "PUNCT" && tl == "," {
                    advance();
                }
            }
            expect_punct(")");
            return attach("PatternVariantBind", join2(node, binds));
        }
        if segs == 1 {
            return "PatternBind(" + root + ")";
        }
        return node;
    }
    report_err("expected pattern");
    advance();
    "PARSE-ERROR"
}

// Cadena de or-patterns: p1 | p2 | ... -> PatternOr(n kids) si hay mas de uno.
fn parse_pattern() -> string {
    let mut alts = "";
    let mut count: i64 = 0;
    let mut more = true;
    while more {
        alts = join2(alts, parse_pattern_alt());
        count = count + 1;
        if tk == "PUNCT" && tl == "|" {
            advance();
        } else {
            more = false;
        }
    }
    if count > 1 {
        return attach("PatternOr(" + to_string(count) + ")", alts);
    }
    alts
}

// DEC-028: match como expresion y como sentencia. Comas OBLIGATORIAS entre
// brazos (el seed sin coma falla — verificado); trailing opcional. Las
// guardas (if expr) se parsean pero NO se emiten: el dump del seed las
// omite (mirror lossy, PHASE2_PROGRESS §7) y el golden sale de ahi.
fn parse_match() -> string {
    advance(); // match
    let saved_nsl = no_struct_lit;
    no_struct_lit = true;
    let target = parse_expr(1);
    no_struct_lit = saved_nsl;
    expect_punct("{");
    let mut arms = "";
    while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
        let pat = parse_pattern();
        if tk == "KEYWORD" && tl == "if" {
            advance();
            let guard_expr = parse_expr(1);
        }
        expect_punct("=>");
        let mut body = "";
        if tk == "PUNCT" && tl == "{" {
            body = parse_block();
        } else {
            body = parse_expr(1);
        }
        arms = join2(arms, attach("Arm", join2(pat, body)));
        if tk == "PUNCT" && tl == "," {
            advance();
        } else if !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            report_err("expected ',' between match arms");
            break;
        }
    }
    expect_punct("}");
    attach("Match", join2(target, arms))
}

fn parse_block() -> string {
    expect_punct("{");
    let mut body = "";
    while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
        let s = parse_stmt();
        body = join2(body, s);
    }
    expect_punct("}");
    attach("Block", body)
}

fn parse_if() -> string {
    advance();
    let saved_nsl = no_struct_lit;
    no_struct_lit = true;
    let cond = parse_expr(1);
    no_struct_lit = saved_nsl;
    let thenb = parse_block();
    let mut kids = join2(cond, thenb);
    if tk == "KEYWORD" && tl == "else" {
        // DEC-028: el seed rechaza '}' NEWLINE 'else' — el else debe
        // cerrar en la misma linea que el '}' del then (E1 verificado;
        // el v1 de este parser era mas permisivo).
        if t_line != prev_line {
            report_err("'else' must close on the same line as '}'");
        } else {
            advance();
            if tk == "KEYWORD" && tl == "if" {
                // el seed envuelve el if-else-if en un Block: Else(Block(If(...)))
                kids = join2(kids, "Else(Block(" + parse_if() + "))");
            } else {
                kids = join2(kids, "Else(" + parse_block() + ")");
            }
        }
    }
    "If(" + kids + ")"
}

fn parse_stmt() -> string {
    if tk == "KEYWORD" && tl == "let" {
        advance();
        let mut is_mut = false;
        if tk == "KEYWORD" && tl == "mut" {
            is_mut = true;
            advance();
        }
        if tk != "IDENT" {
            report_err("expected variable name");
            advance();
            return "PARSE-ERROR";
        }
        let nm = tl;
        advance();
        let mut head = "VarDecl(" + nm;
        if is_mut {
            head = head + ", mut";
        }
        head = head + ")";
        let mut kids = "";
        if tk == "PUNCT" && tl == ":" {
            advance();
            kids = join2(kids, parse_type());
        }
        expect_punct("=");
        kids = join2(kids, parse_expr(1));
        stmt_end();
        return attach(head, kids);
    }
    if tk == "KEYWORD" && tl == "if" {
        return parse_if();
    }
    if tk == "KEYWORD" && tl == "while" {
        advance();
        let saved_nsl = no_struct_lit;
        no_struct_lit = true;
        let cond = parse_expr(1);
        no_struct_lit = saved_nsl;
        let body = parse_block();
        return "While(" + join2(cond, body) + ")";
    }
    if tk == "KEYWORD" && tl == "return" {
        advance();
        if tk == "PUNCT" && tl == ";" {
            advance();
            return "Return";
        }
        // DEC-028: `return x` sin ';' termina en '}' o cambio de línea.
        if tk == "EOF" || (tk == "PUNCT" && tl == "}") || t_line != prev_line {
            return "Return";
        }
        let e = parse_expr(1);
        stmt_end();
        return "Return(" + e + ")";
    }
    if tk == "KEYWORD" && tl == "break" {
        advance();
        stmt_end();
        return "Break";
    }
    // DEC-030: el destino se parsea como expresión (Ident, campo o índice
    // — el seed permite los tres LValue) y un '=' posterior lo convierte
    // en Assign; sin '=', es sentencia de expresión.
    let e = parse_expr(1);
    if tk == "PUNCT" && tl == "=" {
        advance();
        let rhs = parse_expr(1);
        stmt_end();
        return "Assign(" + e + " " + rhs + ")";
    }
    stmt_end();
    e
}

// DEC-030: `fn` compartido por item, trait y impl. sig_only = dentro de
// un trait (firma sin cuerpo → Block vacío, que el seed sintetiza);
// el ':' del parámetro es opcional (el seed lo exige fuera de trait/impl
// vía allow_self — superconjunto declarado en DEC-030 §4).
fn parse_fn(is_pub: bool, sig_only: bool) -> string {
    advance(); // fn
    if tk != "IDENT" {
        report_err("expected function name");
        advance();
        return "PARSE-ERROR";
    }
    let nm = tl;
    advance();
    expect_punct("(");
    let mut kids = "";
    while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
        if tk != "IDENT" {
            report_err("expected parameter name");
            advance();
            return "PARSE-ERROR";
        }
        let pn = tl;
        advance();
        let mut pnode = "Param(" + pn + ")";
        if tk == "PUNCT" && tl == ":" {
            advance();
            pnode = attach(pnode, parse_type());
        }
        kids = join2(kids, pnode);
        if tk == "PUNCT" && tl == "," {
            advance();
        }
    }
    expect_punct(")");
    if tk == "PUNCT" && tl == "->" {
        advance();
        kids = join2(kids, attach("ReturnType", parse_type()));
    }
    if tk == "PUNCT" && tl == "{" {
        kids = join2(kids, parse_block());
    } else if sig_only {
        kids = join2(kids, "Block");
    } else {
        report_err("expected '{' for function body");
        return "PARSE-ERROR";
    }
    if is_pub {
        return attach("PubFnDecl(" + nm + ")", kids);
    }
    return attach("FnDecl(" + nm + ")", kids);
}

fn parse_item() -> string {
    let mut is_pub = false;
    if tk == "KEYWORD" && tl == "pub" {
        is_pub = true;
        advance();
    }
    if tk == "KEYWORD" && tl == "fn" {
        return parse_fn(is_pub, false);
    }
    if tk == "KEYWORD" && tl == "const" {
        advance();
        if tk != "IDENT" {
            report_err("expected const name");
            advance();
            return "PARSE-ERROR";
        }
        let nm = tl;
        advance();
        expect_punct("=");
        let v = parse_expr(1);
        stmt_end();
        if is_pub {
            return attach("PubConstDecl(" + nm + ")", v);
        }
        return attach("ConstDecl(" + nm + ")", v);
    }
    if tk == "KEYWORD" && tl == "enum" {
        // DEC-028: EnumDecl(name) + Variant(v) con Field(TypeIdent) por
        // payload (tipo de payload de un solo ident en v2 — limite declarado).
        advance();
        if tk != "IDENT" {
            report_err("expected enum name");
            advance();
            return "PARSE-ERROR";
        }
        let nm = tl;
        advance();
        expect_punct("{");
        let mut variants = "";
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if tk != "IDENT" {
                report_err("expected variant name");
                advance();
                return "PARSE-ERROR";
            }
            let vn = tl;
            advance();
            let mut fields = "";
            if tk == "PUNCT" && tl == "(" {
                advance();
                while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
                    fields = join2(fields, attach("Field", parse_type()));
                    if tk == "PUNCT" && tl == "," {
                        advance();
                    }
                }
                expect_punct(")");
            }
            variants = join2(variants, attach("Variant(" + vn + ")", fields));
            if tk == "PUNCT" && tl == "," {
                advance();
            }
        }
        expect_punct("}");
        if is_pub {
            return attach("PubEnumDecl(" + nm + ")", variants);
        }
        return attach("EnumDecl(" + nm + ")", variants);
    }
    if tk == "KEYWORD" && tl == "struct" {
        // DEC-030: StructDecl(name) + Field(f) con TypeIdent hijo.
        advance();
        if tk != "IDENT" {
            report_err("expected struct name");
            advance();
            return "PARSE-ERROR";
        }
        let nm = tl;
        advance();
        expect_punct("{");
        let mut fields = "";
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if tk != "IDENT" {
                report_err("expected field name");
                advance();
                return "PARSE-ERROR";
            }
            let fname = tl;
            advance();
            expect_punct(":");
            let ftype = parse_type();
            fields = join2(fields, attach("Field(" + fname + ")", ftype));
            if tk == "PUNCT" && tl == "," {
                advance();
            }
        }
        expect_punct("}");
        if is_pub {
            return attach("PubStructDecl(" + nm + ")", fields);
        }
        return attach("StructDecl(" + nm + ")", fields);
    }
    if tk == "KEYWORD" && tl == "trait" {
        // DEC-030: Trait(name) + firmas fn (sin cuerpo → Block vacío).
        advance();
        if tk != "IDENT" {
            report_err("expected trait name");
            advance();
            return "PARSE-ERROR";
        }
        let nm = tl;
        advance();
        expect_punct("{");
        let mut items = "";
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if !(tk == "KEYWORD" && tl == "fn") {
                report_err("only 'fn' items are supported in a trait");
                break;
            }
            items = join2(items, parse_fn(false, true));
        }
        expect_punct("}");
        if is_pub {
            return attach("PubTrait(" + nm + ")", items);
        }
        return attach("Trait(" + nm + ")", items);
    }
    if tk == "KEYWORD" && tl == "impl" {
        // DEC-030: Impl(Area for Punto) / Impl(Punto) — payload de texto
        // crudo; métodos con cuerpo (sig_only = false).
        if is_pub {
            report_err("'pub' is not supported before impl");
        }
        advance();
        let t1 = parse_path_text();
        let mut head = t1;
        if tk == "KEYWORD" && tl == "for" {
            advance();
            let t2 = parse_path_text();
            head = t1 + " for " + t2;
        }
        expect_punct("{");
        let mut items = "";
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if !(tk == "KEYWORD" && tl == "fn") {
                report_err("only 'fn' items are supported in an impl");
                break;
            }
            items = join2(items, parse_fn(false, false));
        }
        expect_punct("}");
        return attach("Impl(" + head + ")", items);
    }
    if tk == "KEYWORD" && tl == "use" {
        // DEC-030: el dump del seed imprime `Use` SIN payload (mirror lossy).
        if is_pub {
            report_err("'pub' is not supported before use");
        }
        advance();
        let path = parse_path_text();
        stmt_end();
        return "Use";
    }
    if tk == "KEYWORD" && tl == "import" {
        // DEC-030: Import(ruta) o Import(ruta as alias) con texto crudo.
        if is_pub {
            report_err("'pub' is not supported before import");
        }
        advance();
        let path = parse_path_text();
        let mut alias = "";
        if tk == "KEYWORD" && tl == "as" {
            advance();
            if tk != "IDENT" {
                report_err("expected alias name");
                advance();
                return "PARSE-ERROR";
            }
            alias = tl;
            advance();
        }
        stmt_end();
        if alias == "" {
            return "Import(" + path + ")";
        }
        return "Import(" + path + " as " + alias + ")";
    }
    if tk == "KEYWORD" && tl == "from" {
        // DEC-030: From(ruta) + ImportItem(n) / ImportItem(n as a).
        if is_pub {
            report_err("'pub' is not supported before from");
        }
        advance();
        let path = parse_path_text();
        if !(tk == "KEYWORD" && tl == "import") {
            report_err("expected 'import' after module path");
            return "PARSE-ERROR";
        }
        advance();
        let mut items = "";
        let mut done = false;
        while !done {
            if tk != "IDENT" {
                break;
            }
            let inm = tl;
            advance();
            let mut it = "ImportItem(" + inm;
            if tk == "KEYWORD" && tl == "as" {
                advance();
                if tk != "IDENT" {
                    report_err("expected alias name");
                    advance();
                    return "PARSE-ERROR";
                }
                it = it + " as " + tl;
                advance();
            }
            it = it + ")";
            items = join2(items, it);
            if tk == "PUNCT" && tl == "," {
                advance();
            } else {
                done = true;
            }
        }
        stmt_end();
        return attach("From(" + path + ")", items);
    }
    if is_pub {
        report_err("unexpected item after 'pub'");
    } else {
        report_err("expected item (fn/struct/const/enum/trait/impl/use/import/from)");
    }
    advance();
    "PARSE-ERROR"
}

fn parse_module() -> string {
    let mut items = "";
    while tk != "EOF" {
        items = join2(items, parse_item());
    }
    attach("Module", items)
}

fn main() {
    src = read_file("parser_input.astra");
    slen = len(src);
    pos = 0;
    has_look = false;
    cur_line = 1;
    nln = 1;
    t_line = 1;
    prev_line = 1;
    advance();
    print(parse_module());
}
