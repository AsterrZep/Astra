// parser.astra — parser de Astra-0 auto-hospedado (DEC-025..031; tablas SoA
// desde M-T1/DEC-032: el AST vive en `struct Ast` — kind/text/first/next —
// y la s-expresión de una línea es su rendering preorder con attach().
// Lee parser_input.astra (read_file usa path RELATIVO: el gate fija el cwd)
// y emite UNA línea con el AST en s-expresión prefijo:
//   Node(kid1 kid2 ...)  ·  hojas con payload  FnDecl(main)  ·  hojas finas  Break
// El golden es parser.expected, generado con
//   astra-seed --dump-ast parser_input.astra | awk -f normalize_ast.awk
// (implementación independiente: el parser en C vs. éste; el golden sale
// de --dump-ast | normalize_ast.awk — el freshness check los mantiene).
//
// Alcance v2 (DEC-025 + DEC-028): fin de sentencia = ';' O cambio de línea
// O '}' O EOF (espejo del optional_semi del seed); 'else' exige la misma
// línea que el '}' del then; match (comas obligatorias entre brazos,
// guardas parseadas pero NO emitidas — el dump del seed las omite) con
// patrones literal/-unario/string/bool/or/wildcard/ruta calificada/
// binding/PatternVariantBind; items enum (Variant + Field payloads de un
// solo ident). Literales int decimal/string plano/bool, unary -/!,
// precedencia de 27 ops del seed, calls, index, paréntesis, array literals,
// const/fn/params/return-type, let(+mut, tipo opcional), assign,
// if/else/else-if, while, return, break. Sin lambdas, genéricos, campos,
// escapes de string ni operadores a fin de línea (el seed corta la
// sentencia en el NEWLINE — DEC-028 §1).

// ---------- estado del lexer ----------
let mut src = ""
let mut slen: i64 = 0
let mut pos: i64 = 0
let mut tk = ""        // IDENT | INT | STRING | KEYWORD | PUNCT | EOF
let mut tl = ""        // lexeme (STRING incluye las comillas)
let mut ntk = ""       // siguiente token (peek, sin consumir)
let mut ntl = ""
let mut has_look = false
let mut look_tk = ""
let mut look_tl = ""
let mut cur_line: i64 = 1   // línea del scanner (NEWLINE contados en el skip)
let mut nln: i64 = 1        // línea del token recién leído (lex_core)
let mut t_line: i64 = 1     // línea del token actual
let mut prev_line: i64 = 1  // línea del último token consumido
let mut look_line: i64 = 1
let mut ncol: i64 = 1       // columna del token recién leído
let mut look_col: i64 = 1
let mut no_struct_lit = false  // DEC-030: espejo del flag del seed (parser.c:1894)
let mut file_name = "parser_input.astra"
let mut err_count: i64 = 0
let mut line_start: i64 = 0  // offset del primer byte de la línea actual
let mut t_col: i64 = 1       // columna (1-based) del token actual
let mut prev_col: i64 = 1
let mut prev_len: i64 = 0    // largo en bytes del lexeme anterior
let mut stmt_had_semi = false  // espejo de last_stmt_semi del seed (parser.c:42)
let mut emit_guards = false   // M-T3: las guardas SÍ se emiten (el dump del
                              // seed las omite: mirror lossy, PHASE2 §7; el
                              // route golden corre con false y no cambia)
let mut allow_self = false    // espejo de p->allow_self (parser.c:1097):
                              // receptor válido sólo dentro de trait/impl
let mut emit_lambda_types = false  // M-T4b: los tipos de PARÁMETRO de
                              // lambda SÍ se emiten (el dump del seed los
                              // omite — DEC-029; route golden: false)

// ---------- AST en tablas SoA (DEC-032 / M-T1) ----------
// Un nodo = índice en las cuatro columnas (índice 0 = centinela, nunca un
// nodo real): `text` es el texto actual SIN hijos (p. ej. "FnDecl(main)"),
// `first`/`next` son la cadena de hijos (first-child + next-sibling) y
// `kind` indexa `knames` (la etiqueta antes del '('). La s-expresión que
// imprime main es el rendering preorder con el MISMO `attach` de siempre:
// el golden byte-idéntico es la red de seguridad del refactor.
struct Ast {
    kind: [i64]
    text: [string]
    first: [i64]
    next: [i64]
    flg: [i64]        // 1 = expresión final de bloque sin ';' (last_expr)
    ln: [i64]         // línea del token con el que se creó el nodo
    co: [i64]         // columna (para la paridad de diagnósticos del typechecker)
}
let mut tree = Ast { kind: [0], text: [""], first: [0], next: [0], flg: [0], ln: [0], co: [0] }
let mut knames = [""]     // tabla de etiquetas (kind -> nombre)

fn label_of(text: string) -> string {
    let mut i: i64 = 0;
    while i < len(text) {
        if text[i] == "(" {
            return substr(text, 0, i);
        }
        i = i + 1;
    }
    text
}

fn kind_of(text: string) -> i64 {
    let lab = label_of(text);
    let mut i: i64 = 0;
    while i < len(knames) {
        if knames[i] == lab {
            return i;
        }
        i = i + 1;
    }
    knames = push(knames, lab);
    len(knames) - 1
}

fn mk(text: string) -> i64 {
    let idx = len(tree.text);
    tree.text = push(tree.text, text);
    tree.kind = push(tree.kind, kind_of(text));
    tree.first = push(tree.first, 0);
    tree.next = push(tree.next, 0);
    tree.flg = push(tree.flg, 0);
    tree.ln = push(tree.ln, t_line);
    tree.co = push(tree.co, t_col);
    idx
}

// mk con la posicin de OTRO nodo (el seed ancla Call al callee, If al 'if', etc.)
fn mk_like(text: string, src: i64) -> i64 {
    let n = mk(text);
    tree.ln[n] = tree.ln[src];
    tree.co[n] = tree.co[src];
    n
}

fn mark_tail(n: i64) {
    tree.flg[n] = 1;
}

// Texto con arity conocida al final (ArrayLit/PatternOr): reescribir EL
// NODO completo — el kind se internó desde el texto provisional ("") y sin
// esto knames[kind] queda vacío y el typechecker no reconoce la etiqueta.
fn set_text(n: i64, text: string) {
    tree.text[n] = text;
    tree.kind[n] = kind_of(text);
}

fn set_loc(n: i64, ln: i64, co: i64) {
    tree.ln[n] = ln;
    tree.co[n] = co;
}

fn add_child(parent: i64, child: i64) {
    if tree.first[parent] == 0 {
        tree.first[parent] = child;
        return;
    }
    let mut cur = tree.first[parent];
    while tree.next[cur] != 0 {
        cur = tree.next[cur];
    }
    tree.next[cur] = child;
}

// Rendering preorder: el texto del nodo con los hijos insertados con la
// MISMA lógica de attach() del parser de strings (antes del último ')').
fn render(i: i64) -> string {
    let mut kids = "";
    let mut c = tree.first[i];
    while c != 0 {
        kids = join2(kids, render(c));
        c = tree.next[c];
    }
    attach(tree.text[i], kids)
}

fn is_space(c: string) -> bool {
    c == " " || c == "\t" || c == "\r" || c == "\n"
}

fn is_digit(c: string) -> bool {
    c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

fn is_alpha(c: string) -> bool {
    c == "_" || c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f" || c == "g" || c == "h" || c == "i" || c == "j" || c == "k" || c == "l" || c == "m" || c == "n" || c == "o" || c == "p" || c == "q" || c == "r" || c == "s" || c == "t" || c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z" || c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z"
}

fn is_word(c: string) -> bool {
    is_alpha(c) || is_digit(c)
}

fn is_kw(w: string) -> bool {
    w == "fn" || w == "let" || w == "mut" || w == "const" || w == "return" || w == "if" || w == "else" || w == "while" || w == "break" || w == "continue" || w == "true" || w == "false" || w == "match" || w == "enum" || w == "struct" || w == "trait" || w == "impl" || w == "for" || w == "pub" || w == "use" || w == "import" || w == "from" || w == "as" || w == "mod" || w == "var" || w == "in" || w == "some" || w == "none" || w == "ok" || w == "err"
}

// lex_core: escanea UN token en ntk/ntl sin tocar tk/tl (permite peek).
fn lex_core() {
    let mut skipping = true;
    while skipping && pos < slen {
        let c = src[pos];
        if c == "\n" {
            // DEC-028: los NEWLINE se cuentan ANTES de saltarlos — la línea
            // del token es la que decide el fin de sentencia (stmt_end) y
            // las posiciones de error (DEC-031).
            cur_line = cur_line + 1;
            pos = pos + 1;
            line_start = pos;
        } else if c == " " || c == "\t" || c == "\r" {
            pos = pos + 1;
        } else if c == "/" && pos + 1 < slen && src[pos + 1] == "/" {
            while pos < slen && src[pos] != "\n" {
                pos = pos + 1;
            }
        } else {
            skipping = false;
        }
    }
    nln = cur_line;
    ncol = pos - line_start + 1;
    if pos >= slen {
        ntk = "EOF";
        ntl = "";
        return;
    }
    let c = src[pos];
    if c == "\"" {
        let start = pos;
        pos = pos + 1;
        while pos < slen && src[pos] != "\"" {
            if src[pos] == "\\" {
                pos = pos + 1;
            }
            pos = pos + 1;
        }
        if pos < slen {
            pos = pos + 1;
        }
        ntk = "STRING";
        ntl = substr(src, start, pos - start);
        return;
    }
    if is_digit(c) {
        let start = pos;
        while pos < slen && is_digit(src[pos]) {
            pos = pos + 1;
        }
        ntk = "INT";
        ntl = substr(src, start, pos - start);
        return;
    }
    if is_alpha(c) {
        let start = pos;
        while pos < slen && is_word(src[pos]) {
            pos = pos + 1;
        }
        let w = substr(src, start, pos - start);
        ntl = w;
        if is_kw(w) {
            ntk = "KEYWORD";
        } else {
            ntk = "IDENT";
        }
        return;
    }
    if pos + 2 < slen {
        if substr(src, pos, 3) == "..=" {
            ntk = "PUNCT";
            ntl = "..=";
            pos = pos + 3;
            return;
        }
    }
    let mut two = "";
    if pos + 1 < slen {
        two = substr(src, pos, 2);
    }
    if two == ".." || two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "->" || two == "=>" {
        ntk = "PUNCT";
        ntl = two;
        pos = pos + 2;
        return;
    }
    ntk = "PUNCT";
    ntl = c;
    pos = pos + 1;
}

fn advance() {
    if has_look {
        prev_line = t_line;
        prev_col = t_col;
        prev_len = len(tl);
        tk = look_tk;
        tl = look_tl;
        t_line = look_line;
        t_col = look_col;
        has_look = false;
        return;
    }
    lex_core();
    prev_line = t_line;
    prev_col = t_col;
    prev_len = len(tl);
    tk = ntk;
    tl = ntl;
    t_line = nln;
    t_col = ncol;
}

fn peek_kind() -> string {
    if !has_look {
        lex_core();
        look_tk = ntk;
        look_tl = ntl;
        look_line = nln;
        look_col = ncol;
        has_look = true;
    }
    look_tk
}

fn peek_lex() -> string {
    if !has_look {
        lex_core();
        look_tk = ntk;
        look_tl = ntl;
        look_line = nln;
        look_col = ncol;
        has_look = true;
    }
    look_tl
}

// ---------- utilidades de composición ----------
fn join2(a: string, b: string) -> string {
    // early returns: el if-expressions multilinea como cola de fn todavía no
    // tipa en los dos compiladores («if branches have different types»)
    if a == "" {
        return b;
    }
    if b == "" {
        return a;
    }
    a + " " + b
}

fn starts_with(s: string, p: string) -> bool {
    let n = len(p);
    if len(s) < n {
        return false;
    }
    let mut i: i64 = 0;
    while i < n {
        if s[i] != p[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// attach("FnDecl(main)", "Param(a ...) Block(...)") inserta los kids antes
// del ÚLTIMO ')' del texto; sin ')' y con kids, abre uno nuevo.
fn attach(text: string, kids: string) -> string {
    if kids == "" {
        return text;
    }
    let mut p: i64 = -1;
    let mut i: i64 = len(text) - 1;
    while i >= 0 {
        if text[i] == ")" {
            p = i;
            i = -1;
        } else {
            i = i - 1;
        }
    }
    if p < 0 {
        return text + "(" + kids + ")";
    }
    return substr(text, 0, p) + " " + kids + substr(text, p, len(text) - p);
}

// ---------- diagnósticos (DEC-031) ----------
// Formato del seed: file:line:col: error: <msg> (parser.c:78-79/133-134),
// got = token_kind_name (driver.c:7-93). Las dos formas:
//   expect-style: `expected <msg>, got <kind>` (expect())
//   perr-style:   `<msg>` sin got (parser_error())
fn kind_name() -> string {
    if tk == "IDENT" && tl == "_" {
        // El seed lexea '_' como token WILDCARD propio (got _ en los
        // expect) — verificado con match_no_comma.
        return "_";
    }
    if tk == "IDENT" {
        return "IDENT";
    }
    if tk == "INT" {
        return "INT_LIT";
    }
    if tk == "STRING" {
        return "STRING_LIT";
    }
    if tk == "EOF" {
        return "EOF";
    }
    tl
}

fn report_at(line: i64, col: i64, msg: string) {
    err_count = err_count + 1;
    print(file_name + ":" + to_string(line) + ":" + to_string(col) + ": error: " + msg);
}

// parser_error: se reporta SIEMPRE en el token actual (sin got).
fn perr(msg: string) {
    report_at(t_line, t_col, msg);
}

// expect(): `expected <msg>, got <kind>`. Si un NEWLINE separa el último
// token consumido del actual, el seed (que tiene tokens NEWLINE) habría
// fallado EN el NEWLINE: se sintetiza la posición fin-de-línea y got
// NEWLINE (verificado: print(1\n} → expected ')', got NEWLINE).
fn ef(msg: string) {
    if t_line != prev_line {
        report_at(prev_line, prev_col + prev_len, "expected " + msg + ", got NEWLINE");
    } else {
        report_at(t_line, t_col, "expected " + msg + ", got " + kind_name());
    }
}

// Igual que ef pero SIN síntesis de NEWLINE: para los expects que en el
// seed van precedidos de skip_newlines (p. ej. el '}' de un match) o
// donde el token actual es el que se reporta (verificado por fixture).
fn ef_now(msg: string) {
    report_at(t_line, t_col, "expected " + msg + ", got " + kind_name());
}

fn expect_punct(w: string) {
    if tk == "PUNCT" && tl == w {
        advance();
        return;
    }
    ef_now("'" + w + "'");
    advance();
}

// Cierre de expresión con síntesis de NEWLINE (call ')' — verificado e2).
fn expect_punct_nl(w: string) {
    if tk == "PUNCT" && tl == w {
        advance();
        return;
    }
    ef("'" + w + "'");
    advance();
}

// DEC-031 (corrige el modelo de DEC-028 §1): el seed NUNCA exige
// separador — optional_semi consume ';' si está, pero `print(1) print(2)`
// y `let x = 1 let y = 2` en una misma línea parsean y corren (verificado
// s1/s2/s4/s5). stmt_end sólo consume el ';' opcional; elNEWLINE sólo
// importa para el binding del 'else' y para la síntesis de posiciones.
fn stmt_end() {
    if tk == "PUNCT" && tl == ";" {
        advance();
        stmt_had_semi = true;
    }
}

// ---------- precedencia (tabla de --dump-operators) ----------
fn bp_of(op: string) -> i64 {
    if op == ".." || op == "..=" {
        return 2;   // PREC_RANGE del seed (entre ASSIGN y ||)
    }
    if op == "||" {
        return 3;
    }
    if op == "&&" {
        return 4;
    }
    if op == "==" || op == "!=" {
        return 8;
    }
    if op == "<" || op == ">" || op == "<=" || op == ">=" {
        return 9;
    }
    if op == "+" || op == "-" {
        return 11;
    }
    if op == "*" || op == "/" || op == "%" {
        return 12;
    }
    0
}

// ---------- parser ----------
// DEC-030: ruta de módulo punteada — sólo IDENT tras cada '.' (una
// palabra clave tras el punto es error, espejo de ui/import_keyword_segment).
fn parse_path_text() -> string {
    if tk != "IDENT" {
        ef("module path");
        advance();
        return "?";
    }
    let mut path = tl;
    advance();
    while tk == "PUNCT" && tl == "." {
        advance();
        if tk != "IDENT" {
            ef("module path segment");
            advance();
            return path + ".?";
        }
        path = path + "." + tl;
        advance();
    }
    path
}

fn parse_type() -> i64 {
    if tk == "IDENT" {
        let t = mk("TypeIdent(" + tl + ")");
        advance();
        if tk == "PUNCT" && tl == "?" {
            // OptionalType ::= PrimaryType "?" (parser.c:1759; loc = '?')
            let qln = t_line;
            let qlc = t_col;
            advance();
            let on = mk("TypeOptional");
            set_loc(on, qln, qlc);
            add_child(on, t);
            return on;
        }
        return t;
    }
    if tk == "KEYWORD" && tl == "fn" {
        // parse_type_impl del seed (parser.c, rama TOKEN_FN): fn(T,...) -> R.
        // Los hijos van en orden params..., retorno — el retorno se marca
        // con flg=2 para distinguirlo de `fn(T)` sin anotación (el dump
        // imprime ambos como hijos planos: TypeFn TypeIdent...).
        let fln = t_line;
        let flc = t_col;
        advance();
        let tn = mk("TypeFn");
        set_loc(tn, fln, flc);
        expect_punct("(");
        if !(tk == "PUNCT" && tl == ")") {
            let mut go = true;
            while go {
                add_child(tn, parse_type());
                if tk == "PUNCT" && tl == "," {
                    advance();
                } else {
                    go = false;
                }
            }
        }
        expect_punct(")");
        if tk == "PUNCT" && tl == "->" {
            advance();
            let rt = parse_type();
            tree.flg[rt] = 2;   // marca: hijo = retorno, no parámetro
            add_child(tn, rt);
        }
        return tn;
    }
    perr("expected type");
    advance();
    mk("TypeIdent(?)")
}

fn parse_expr(min_bp: i64) -> i64 {
    let mut left: i64 = 0;
    if tk == "PUNCT" && (tl == "-" || tl == "!") {
        let op = tl;
        advance();
        let un = mk("UnaryOp(" + op + ")");
        add_child(un, parse_expr(13));
        left = un;
    } else {
        left = parse_primary();
    }
    // Postfix en ORDEN de fuente (v2: un solo loop — `Size.S`, `f(x).y`,
    // `a[i].z` en cualquier orden; los tres loops separados del v1 no
    // podian encadenarse entre si).
    let mut postfixing = true;
    while postfixing {
        if tk == "PUNCT" && tl == "." {
            advance();
            if tk != "IDENT" {
                ef_now("field name");
                advance();
                left = mk("PARSE-ERROR");
            } else {
                let fa = mk("FieldAccess(" + tl + ")");
                set_loc(fa, tree.ln[left], tree.co[left]); // loc del seed: left->loc
                add_child(fa, left);
                left = fa;
                advance();
            }
        } else if tk == "PUNCT" && tl == "(" {
            advance();
            let calln = mk("Call");
            set_loc(calln, tree.ln[left], tree.co[left]);
            add_child(calln, left);
            while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
                let a = parse_expr(1);
                add_child(calln, a);
                if tk == "PUNCT" && tl == "," {
                    advance();
                } else {
                    // DEC-031: sin coma se SALE — el expect de ')' reporta
                    // el primer error (verificado: expected ')', got NEWLINE).
                    break;
                }
            }
            expect_punct_nl(")");
            left = calln;
        } else if tk == "PUNCT" && tl == "[" {
            advance();
            let idx = parse_expr(1);
            expect_punct("]");
            let ix = mk("Index");
            set_loc(ix, tree.ln[left], tree.co[left]); // loc del seed: left->loc
            add_child(ix, left);
            add_child(ix, idx);
            left = ix;
        } else if tk == "PUNCT" && tl == "?" {
            // parser.c:2075: TryExpr con loc = el propio '?'
            let qln = t_line;
            let qlc = t_col;
            advance();
            let tn = mk("TryExpr");
            set_loc(tn, qln, qlc);
            add_child(tn, left);
            left = tn;
        } else {
            postfixing = false;
        }
    }
    while true {
        if tk != "PUNCT" {
            break;
        }
        let bp = bp_of(tl);
        if bp == 0 || bp < min_bp {
            break;
        }
        let op = tl;
        advance();
        if op == ".." || op == "..=" {
            // parse_range del seed: loc = left; fin abierto cuando el
            // siguiente token no puede abrir una expresión.
            let mut end: i64 = 0;
            let term = tk == "EOF" || (tk == "PUNCT" && (tl == ";" || tl == "," || tl == ")" || tl == "]" || tl == "}"));
            if !term {
                end = parse_expr(bp + 1);
            }
            let rn = mk("Range(" + op + ")");
            set_loc(rn, tree.ln[left], tree.co[left]);
            add_child(rn, left);
            if end != 0 {
                add_child(rn, end);
            }
            left = rn;
        } else {
            let right = parse_expr(bp + 1);
            let bn = mk("BinaryOp(" + op + ")");
            add_child(bn, left);
            add_child(bn, right);
            left = bn;
        }
    }
    left
}

fn parse_primary() -> i64 {
    if tk == "INT" {
        let t = mk("IntLit(" + tl + ")");
        advance();
        return t;
    }
    if tk == "STRING" {
        let t = mk("StringLit(" + tl + ")");
        advance();
        return t;
    }
    if tk == "KEYWORD" && (tl == "true" || tl == "false") {
        let t = mk("BoolLit(" + tl + ")");
        advance();
        return t;
    }
    if tk == "KEYWORD" && tl == "match" {
        return parse_match();
    }
    if tk == "KEYWORD" && (tl == "some" || tl == "ok" || tl == "err") {
        // parser.c:1925-1950: SomeExpr/OkExpr/ErrExpr con '(' obligatorio
        let kw = tl;
        let kln = t_line;
        let klc = t_col;
        advance();
        if tk == "PUNCT" && tl == "(" {
            advance();
        } else {
            ef("'(' after " + kw);
            advance();
            return mk("PARSE-ERROR");
        }
        let val = parse_expr(1);
        if tk == "PUNCT" && tl == ")" {
            advance();
        } else {
            ef("')'");
            advance();
        }
        let mut en: i64 = 0;
        if kw == "some" {
            en = mk("SomeExpr");
        } else if kw == "ok" {
            en = mk("OkExpr");
        } else {
            en = mk("ErrExpr");
        }
        set_loc(en, kln, klc);
        add_child(en, val);
        return en;
    }
    if tk == "KEYWORD" && tl == "none" {
        let kln = t_line;
        let klc = t_col;
        advance();
        let nn = mk("NoneExpr");
        set_loc(nn, kln, klc);
        return nn;
    }
    if tk == "PUNCT" && (tl == "|" || tl == "||") {
        // DEC-029: en posición de expresión un '|' inicial SOLO puede ser
        // lambda (el '|' binario nunca abre expresión; el seed es igual).
        return parse_lambda();
    }
    if tk == "IDENT" {
        // DEC-030: `IDENT {` es struct literal salvo con el flag activo
        // (condiciones de if/while y target de match — el seed decide con
        // no_struct_lit, no con lookahead: parser.c:1894). Los argumentos
        // de llamada heredan el flag igual que en el seed.
        if !no_struct_lit && peek_kind() == "PUNCT" && peek_lex() == "{" {
            let name = tl;
            let idl = t_line;
            let idc = t_col;   // el seed: loc = id.loc (el ident, no el '{')
            advance(); // consume el ident; tk ahora es '{'
            advance(); // consume '{'
            let sl = mk("StructLit(" + name + ")");
            set_loc(sl, idl, idc);
            while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
                if tk != "IDENT" {
                    ef_now("field name");
                    advance();
                    return mk("PARSE-ERROR");
                }
                let fname = tl;
                advance();
                expect_punct(":");
                let val = parse_expr(1);
                let fnode = mk("Field(" + fname + ")");
                add_child(fnode, val);
                add_child(sl, fnode);
                if tk == "PUNCT" && tl == "," {
                    advance();
                } else {
                    break;
                }
            }
            expect_punct("}");
            return sl;
        }
        let t = mk("Ident(" + tl + ")");
        advance();
        return t;
    }
    if tk == "PUNCT" && tl == "(" {
        // DEC-030: dentro de paréntesis los struct literals vuelven a ser
        // legales (el seed restablece el flag, parser.c:289).
        advance();
        let saved_nsl = no_struct_lit;
        no_struct_lit = false;
        let inner = parse_expr(1);
        no_struct_lit = saved_nsl;
        expect_punct(")");
        return inner;
    }
    if tk == "PUNCT" && tl == "[" {
        let al = t_line;
        let ac = t_col;
        advance();
        let arr = mk(""); // texto provisional: la aridad se conoce al final
        set_loc(arr, al, ac);
        let mut count: i64 = 0;
        while !(tk == "PUNCT" && tl == "]") && tk != "EOF" {
            let e = parse_expr(1);
            add_child(arr, e);
            count = count + 1;
            if tk == "PUNCT" && tl == "," {
                advance();
            } else {
                break;
            }
        }
        expect_punct("]");
        set_text(arr, "ArrayLit(" + to_string(count) + ")");
        return arr;
    }
    perr("unexpected token in expression");
    advance();
    mk("PARSE-ERROR")
}

// DEC-029: lambda — |params| [-> type] { block }. El cuerpo DEBE ser
// bloque (el seed rechaza el cuerpo sin llaves). Los tipos de parámetro y
// la anotación -> type se parsean pero NO se emiten: el dump del seed
// imprime `Lambda [Param(name)]* [TypeIdent(ret)] Block` — el TypeIdent
// es SOLO la anotación de retorno (verificado; los tipos de parámetro no
// aparecen). Sin parámetros: `||` (token OR_OR, tratado como lista vacía)
// o `| |` (dos PUNCT) — el mismo loop cubre ambas grafías.
fn parse_lambda() -> i64 {
    let lam = mk("Lambda");
    if tk == "PUNCT" && tl == "||" {
        advance();
    } else {
        advance(); // abre '|'
        while !(tk == "PUNCT" && tl == "|") && tk != "EOF" {
            if tk != "IDENT" {
                ef_now("parameter name");
                advance();
                return mk("PARSE-ERROR");
            }
            let pn = mk("Param(" + tl + ")");
            advance();
            if tk == "PUNCT" && tl == ":" {
                advance();
                let ptype = parse_type(); // el dump del seed NO la imprime
                if emit_lambda_types {
                    add_child(pn, ptype); // el typechecker sí la necesita
                }
            }
            add_child(lam, pn);
            if tk == "PUNCT" && tl == "," {
                advance();
            }
        }
        if tk == "PUNCT" && tl == "|" {
            advance();
        } else {
            ef_now("'|' after lambda parameters");
            advance();
        }
    }
    if tk == "PUNCT" && tl == "->" {
        advance();
        let rtype = parse_type(); // el dump SÍ imprime el ret como TypeIdent
        add_child(lam, rtype);
    }
    if tk != "PUNCT" || tl != "{" {
        ef_now("'{' for lambda body");
        return mk("PARSE-ERROR");
    }
    add_child(lam, parse_block());
    lam
}

// DEC-028: una alternativa de patron (sin el '|'). La misma forma que la
// expresion para las rutas: Size.XS -> FieldAccess(XS Ident(Size)).
fn parse_pattern_alt() -> i64 {
    if tk == "PUNCT" && tl == "-" {
        advance();
        if tk == "INT" {
            let n = tl;
            advance();
            let un = mk("UnaryOp(-)");
            add_child(un, mk("IntLit(" + n + ")"));
            return un;
        }
        perr("expected a numeric literal after '-' in pattern");
        advance();
        return mk("PARSE-ERROR");
    }
    if tk == "INT" {
        let t = mk("IntLit(" + tl + ")");
        advance();
        return t;
    }
    if tk == "STRING" {
        let t = mk("StringLit(" + tl + ")");
        advance();
        return t;
    }
    if tk == "KEYWORD" && (tl == "true" || tl == "false") {
        let t = mk("BoolLit(" + tl + ")");
        advance();
        return t;
    }
    if tk == "KEYWORD" && (tl == "some" || tl == "ok" || tl == "err") {
        // parser.c:783: PatternBuiltinVariant(bvk) + payload opcional
        let mut bvk = 2;
        if tl == "ok" { bvk = 0; }
        if tl == "err" { bvk = 1; }
        let kln = t_line;
        let klc = t_col;
        advance();
        let pb = mk("PatternBuiltinVariant(" + to_string(bvk) + ")");
        set_loc(pb, kln, klc);
        if tk == "PUNCT" && tl == "(" {
            advance();
            add_child(pb, parse_pattern());
            if tk == "PUNCT" && tl == ")" {
                advance();
            } else {
                ef("')' after pattern");
                advance();
            }
        }
        return pb;
    }
    if tk == "KEYWORD" && tl == "none" {
        let kln = t_line;
        let klc = t_col;
        advance();
        let pb = mk("PatternBuiltinVariant(3)");
        set_loc(pb, kln, klc);
        return pb;
    }
    if tk == "IDENT" {
        if tl == "_" {
            advance();
            return mk("PatternWildcard");
        }
        let root = tl;
        let rln = t_line;   // loc raíz: el seed ata Ident/FieldAccess/PVB
        let rco = t_col;    // al ident de la raíz (id.loc)
        advance();
        let mut node = mk("Ident(" + root + ")");
        set_loc(node, rln, rco);
        let mut segs: i64 = 1;
        while tk == "PUNCT" && tl == "." {
            advance();
            if tk != "IDENT" {
                perr("expected a pattern ('_', literal or Enum.Variant)");
                advance();
                return mk("PARSE-ERROR");
            }
            let fa = mk("FieldAccess(" + tl + ")");
            set_loc(fa, rln, rco);
            add_child(fa, node);
            node = fa;
            segs = segs + 1;
            advance();
        }
        if tk == "PUNCT" && tl == "(" {
            // payload de variante: Point.Pt(a, b) — DEC-008 exige la ruta
            // calificada; sin wildcard por campo (el seed lo rechaza).
            if segs < 2 {
                perr("enum patterns must be qualified (Enum.Variant)");
            }
            advance();
            let pv = mk("PatternVariantBind");
            set_loc(pv, rln, rco);
            add_child(pv, node);
            while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
                if tk != "IDENT" {
                    perr("expected binding name");
                    advance();
                    return mk("PARSE-ERROR");
                }
                add_child(pv, mk("Bind(" + tl + ")"));
                advance();
                if tk == "PUNCT" && tl == "," {
                    advance();
                }
            }
            expect_punct(")");
            return pv;
        }
        if segs == 1 {
            return mk("PatternBind(" + root + ")");
        }
        return node;
    }
    perr("expected a pattern ('_', literal or Enum.Variant)");
    advance();
    mk("PARSE-ERROR")
}

// Cadena de or-patterns: p1 | p2 | ... -> PatternOr(n kids) si hay mas de uno.
fn parse_pattern() -> i64 {
    let first = parse_pattern_alt();
    if !(tk == "PUNCT" && tl == "|") {
        return first;
    }
    // or-chain: el número de alternativas sólo se conoce al final — texto
    // provisional como en ArrayLit.
    let por = mk("");
    add_child(por, first);
    let mut count: i64 = 1;
    while tk == "PUNCT" && tl == "|" {
        advance();
        add_child(por, parse_pattern_alt());
        count = count + 1;
    }
    set_text(por, "PatternOr(" + to_string(count) + ")");
    por
}

// DEC-028: match como expresion y como sentencia. Comas OBLIGATORIAS entre
// brazos (el seed sin coma falla — verificado); trailing opcional. Las
// guardas (if expr) se parsean pero NO se emiten: el dump del seed las
// omite (mirror lossy, PHASE2_PROGRESS §7) y el golden sale de ahi.
fn parse_match() -> i64 {
    let mln = t_line;
    let mco = t_col;   // el seed: loc = p->previous.loc (la keyword match)
    advance(); // match
    let saved_nsl = no_struct_lit;
    no_struct_lit = true;
    let target = parse_expr(1);
    no_struct_lit = saved_nsl;
    if tk == "PUNCT" && tl == "{" {
        advance();
    } else {
        ef_now("'{' for match");
        advance();
    }
    let mn = mk("Match");
    set_loc(mn, mln, mco);
    add_child(mn, target);
    while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
        let pat = parse_pattern();
        let arm = mk("Arm");
        add_child(arm, pat);
        if tk == "KEYWORD" && tl == "if" {
            advance();
            let guard_expr = parse_expr(1); // guardas: parseadas siempre
            if emit_guards {
                // M-T3: el typechecker auto-hospedado necesita la guarda
                // (tipo + exclusión de cobertura). El dump del seed no la
                // imprime, así que el route golden la sigue omitiendo.
                add_child(arm, guard_expr);
            }
        }
        expect_punct("=>");
        let mut body: i64 = 0;
        if tk == "PUNCT" && tl == "{" {
            body = parse_block();
        } else {
            body = parse_expr(1);
        }
        add_child(arm, body);
        add_child(mn, arm);
        if tk == "PUNCT" && tl == "," {
            advance();
        } else if !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            // DEC-031: el seed NO reporta la coma: rompe el bucle y el '}'
            // esperado choca con el primer token del siguiente brazo
            // (verificado: expected '}', got INT_LIT).
            break;
        }
    }
    expect_punct("}");
    mn
}

fn parse_block() -> i64 {
    expect_punct("{");
    let blk = mk("Block");
    while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
        let s = parse_stmt();
        add_child(blk, s);
        // DEC-034: última expresión sin ';' = last_expr del seed — sólo
        // esa marca cambia el TIPO del bloque (void vs tipo de la cola);
        // el rendering no la muestra, así que el golden no cambia.
        if !stmt_had_semi {
            mark_tail(s);
        }
    }
    expect_punct("}");
    blk
}

fn parse_if() -> i64 {
    let ifl = t_line;
    let ifc = t_col;
    advance();
    let saved_nsl = no_struct_lit;
    no_struct_lit = true;
    let cond = parse_expr(1);
    no_struct_lit = saved_nsl;
    let thenb = parse_block();
    let ifn = mk("If");
    set_loc(ifn, ifl, ifc);
    add_child(ifn, cond);
    add_child(ifn, thenb);
    if tk == "KEYWORD" && tl == "else" && t_line == prev_line {
        // DEC-031: el 'else' sólo se une al if en la MISMA línea del '}'
        // del then (el seed: el NEWLINE rompe match(ELSE) y el 'else'
        // cae como sentencia → unexpected token in expression, verificado).
        advance();
        let elsen = mk("Else");
        if tk == "KEYWORD" && tl == "if" {
            // el seed envuelve el if-else-if en un Block: Else(Block(If(...)))
            let wrapper = mk("Block");
            add_child(elsen, wrapper);
            add_child(wrapper, parse_if());
        } else {
            add_child(elsen, parse_block());
        }
        add_child(ifn, elsen);
    }
    ifn
}

fn parse_stmt() -> i64 {
    stmt_had_semi = false;
    if tk == "KEYWORD" && tl == "let" {
        let letl = t_line;
        let letc = t_col;
        advance();
        let mut is_mut = false;
        if tk == "KEYWORD" && tl == "mut" {
            is_mut = true;
            advance();
        }
        if tk != "IDENT" {
            ef("variable name");
            advance();
            return mk("PARSE-ERROR");
        }
        let nm = tl;
        advance();
        let mut head = "VarDecl(" + nm;
        if is_mut {
            head = head + ", mut";
        }
        head = head + ")";
        let vd = mk(head);
        set_loc(vd, letl, letc);
        if tk == "PUNCT" && tl == ":" {
            advance();
            add_child(vd, parse_type());
        }
        // DEC-031: '=' es OPCIONAL (el seed: `let x 5;` parsea como
        // VarDecl(x) + sentencia 5; — verificado s5).
        if tk == "PUNCT" && tl == "=" {
            advance();
            add_child(vd, parse_expr(1));
        }
        stmt_end();
        return vd;
    }
    if tk == "KEYWORD" && tl == "if" {
        return parse_if();
    }
    if tk == "KEYWORD" && tl == "while" {
        advance();
        let saved_nsl = no_struct_lit;
        no_struct_lit = true;
        let cond = parse_expr(1);
        no_struct_lit = saved_nsl;
        let body = parse_block();
        let wn = mk("While");
        add_child(wn, cond);
        add_child(wn, body);
        return wn;
    }
    if tk == "KEYWORD" && tl == "for" {
        // parse_for del seed (parser.c:720): loc = keyword; var; 'in';
        // iter con no_struct_lit; '{' obligatorio (sin él el body va NULL).
        let fln = t_line;
        let flc = t_col;
        advance();
        if tk != "IDENT" {
            ef("loop variable name");
            advance();
            return mk("PARSE-ERROR");
        }
        let vnm = tl;
        advance();
        if tk == "KEYWORD" && tl == "in" {
            advance();
        } else {
            ef("'in'");
            advance();
            return mk("PARSE-ERROR");
        }
        let saved_nsl = no_struct_lit;
        no_struct_lit = true;
        let iter = parse_expr(1);
        no_struct_lit = saved_nsl;
        let fnod = mk("For(" + vnm + ")");
        set_loc(fnod, fln, flc);
        add_child(fnod, iter);
        if tk == "PUNCT" && tl == "{" {
            add_child(fnod, parse_block());
        } else {
            ef("'{' for for body");
            return fnod;
        }
        // return explícito (como el resto de casos de parse_stmt): una
        // cola desnuda tras el `if` no devolvía el nodo (verificado con el
        // tree del mini `for i in 0..5`).
        return fnod;
    }
    if tk == "KEYWORD" && tl == "return" {
        let retl = t_line;
        let retc = t_col;
        advance();
        if tk == "PUNCT" && tl == ";" {
            advance();
            let r0 = mk("Return");
            set_loc(r0, retl, retc);
            return r0;
        }
        // DEC-028: `return x` sin ';' termina en '}' o cambio de línea.
        if tk == "EOF" || (tk == "PUNCT" && tl == "}") || t_line != prev_line {
            let r1 = mk("Return");
            set_loc(r1, retl, retc);
            return r1;
        }
        let e = parse_expr(1);
        stmt_end();
        let rn = mk("Return");
        set_loc(rn, retl, retc);
        add_child(rn, e);
        return rn;
    }
    if tk == "KEYWORD" && tl == "break" {
        advance();
        // `break <valor>` — el seed lo rechaza en el parser (parser.c:1832);
        // mismo texto y posición (token del valor): paridad, no decisión nueva.
        if tk != "EOF" && !(tk == "PUNCT" && tl == ";") && !(tk == "PUNCT" && tl == "}") && t_line == prev_line {
            perr("break with a value is not supported in Astra-0");
            advance();
            return mk("Break");
        }
        stmt_end();
        return mk("Break");
    }
    if tk == "KEYWORD" && tl == "continue" {
        advance();
        stmt_end();
        return mk("Continue");
    }
    // DEC-030: el destino se parsea como expresión (Ident, campo o índice
    // — el seed permite los tres LValue) y un '=' posterior lo convierte
    // en Assign; sin '=', es sentencia de expresión.
    let e = parse_expr(1);
    if tk == "PUNCT" && tl == "=" {
        advance();
        // DEC-031: LValue del seed (parser.c:396-398) — el reporte cae en
        // el token DESPUÉS del '=' (verificado: 1 = 2 → en el 2).
        let et = tree.text[e];
        if !(starts_with(et, "Ident(") || starts_with(et, "FieldAccess(") || starts_with(et, "Index(")) {
            perr("invalid assignment target");
        }
        let rhs = parse_expr(1);
        stmt_end();
        let an = mk("Assign");
        set_loc(an, tree.ln[e], tree.co[e]);
        add_child(an, e);
        add_child(an, rhs);
        return an;
    }
    stmt_end();
    e
}

// DEC-030: `fn` compartido por item, trait y impl. sig_only = dentro de
// un trait (firma sin cuerpo → Block vacío, que el seed sintetiza);
// el ':' del parámetro es opcional (el seed lo exige fuera de trait/impl
// vía allow_self — superconjunto declarado en DEC-030 §4).
fn parse_fn(is_pub: bool, sig_only: bool) -> i64 {
    let fnl = t_line;
    let fnc = t_col;
    advance(); // fn
    if tk != "IDENT" {
        ef("function name");
        advance();
        return mk("PARSE-ERROR");
    }
    let nm = tl;
    advance();
    let mut fnn: i64 = 0;
    if is_pub {
        fnn = mk("PubFnDecl(" + nm + ")");
    } else {
        fnn = mk("FnDecl(" + nm + ")");
    }
    set_loc(fnn, fnl, fnc);
    expect_punct("(");
    let mut nparams: i64 = 0;   // para las reglas de `self` (parser.c:1097)
    let mut self_err = false;
    while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
        if tk != "IDENT" {
            ef("parameter name");
            advance();
            return mk("PARSE-ERROR");
        }
        let pn = tl;
        advance();
        let pnode = mk("Param(" + pn + ")");
        if tk == "PUNCT" && tl == ":" {
            advance();
            add_child(pnode, parse_type());
        } else if pn == "self" {
            // `self` sin anotación es el receptor: fuera de trait/impl o
            // llegando tarde es error, pero el parámetro se añade igual
            // (seed: fn_add_param tras parser_error).
            if !allow_self {
                perr("'self' parameter outside a trait or impl");
                self_err = true;
            } else if nparams > 0 {
                perr("'self' must be the first parameter");
                self_err = true;
            }
        }
        add_child(fnn, pnode);
        nparams = nparams + 1;
        if tk == "PUNCT" && tl == "," {
            advance();
        }
    }
    expect_punct(")");
    if allow_self {
        // Un item de trait/impl es un método: sin receptor sería una
        // función estática sin sintaxis de llamada (parser.c:1130).
        let mut has_self = false;
        if nparams > 0 {
            let p0 = tree.first[fnn];
            // "Param(self)" -> "self" (el payload del Param)
            if p0 != 0 && substr(tree.text[p0], 6, len(tree.text[p0]) - 7) == "self" {
                has_self = true;
            }
        }
        if !has_self && !self_err {
            perr("'self' is required as the first parameter of a method");
        }
    }
    if tk == "PUNCT" && tl == "->" {
        advance();
        let rn = mk("ReturnType");
        add_child(rn, parse_type());
        add_child(fnn, rn);
    }
    if tk == "PUNCT" && tl == "{" {
        add_child(fnn, parse_block());
    } else if sig_only {
        if tk == "PUNCT" && tl == ";" {
            advance(); // terminador opcional: `fn show(self);` (parser.c:1158)
        }
        add_child(fnn, mk("Block"));
    } else {
        ef_now("'{' for function body");
        return mk("PARSE-ERROR");
    }
    fnn
}

fn parse_item() -> i64 {
    let mut is_pub = false;
    if tk == "KEYWORD" && tl == "pub" {
        is_pub = true;
        advance();
    }
    if tk == "KEYWORD" && tl == "fn" {
        return parse_fn(is_pub, false);
    }
    if tk == "KEYWORD" && tl == "const" {
        let col = t_line;
        let coc = t_col;
        advance();
        if tk != "IDENT" {
            ef("variable name");
            advance();
            return mk("PARSE-ERROR");
        }
        let nm = tl;
        advance();
        expect_punct("=");
        let v = parse_expr(1);
        stmt_end();
        if is_pub {
            let cn = mk("PubConstDecl(" + nm + ")");
            set_loc(cn, col, coc);
            add_child(cn, v);
            return cn;
        }
        let cn = mk("ConstDecl(" + nm + ")");
        set_loc(cn, col, coc);
        add_child(cn, v);
        return cn;
    }
    if tk == "KEYWORD" && tl == "enum" {
        // DEC-028: EnumDecl(name) + Variant(v) con Field(TypeIdent) por
        // payload (tipo de payload de un solo ident en v2 — limite declarado).
        let kln = t_line;
        let klc = t_col;   // loc del nodo = la keyword (p->previous.loc)
        advance();
        if tk != "IDENT" {
            ef("enum name");
            advance();
            return mk("PARSE-ERROR");
        }
        let nm = tl;
        advance();
        expect_punct("{");
        let mut en: i64 = 0;
        if is_pub {
            en = mk("PubEnumDecl(" + nm + ")");
        } else {
            en = mk("EnumDecl(" + nm + ")");
        }
        set_loc(en, kln, klc);
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if tk != "IDENT" {
                ef("variant name");
                advance();
                return mk("PARSE-ERROR");
            }
            let vn = tl;
            advance();
            let variant = mk("Variant(" + vn + ")");
            if tk == "PUNCT" && tl == "(" {
                advance();
                while !(tk == "PUNCT" && tl == ")") && tk != "EOF" {
                    let fld = mk("Field");
                    add_child(fld, parse_type());
                    add_child(variant, fld);
                    if tk == "PUNCT" && tl == "," {
                        advance();
                    }
                }
                expect_punct(")");
            }
            add_child(en, variant);
            // Sin coma entre variantes: el seed las rechaza (ui/enum_comma_body
            // — DEC-028 sólo permite el separador por nueva línea).
        }
        expect_punct("}");
        return en;
    }
    if tk == "KEYWORD" && tl == "struct" {
        // DEC-030: StructDecl(name) + Field(f) con TypeIdent hijo.
        let kln = t_line;
        let klc = t_col;   // loc del nodo = la keyword (p->previous.loc)
        advance();
        if tk != "IDENT" {
            ef("struct name");
            advance();
            return mk("PARSE-ERROR");
        }
        let nm = tl;
        advance();
        expect_punct("{");
        let mut st: i64 = 0;
        if is_pub {
            st = mk("PubStructDecl(" + nm + ")");
        } else {
            st = mk("StructDecl(" + nm + ")");
        }
        set_loc(st, kln, klc);
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if tk != "IDENT" {
                ef("field name");
                advance();
                return mk("PARSE-ERROR");
            }
            let fname = tl;
            advance();
            expect_punct(":");
            let ftype = parse_type();
            let fld = mk("Field(" + fname + ")");
            add_child(fld, ftype);
            add_child(st, fld);
            // Sin coma entre campos: el seed la rechaza (ui/struct_comma_body).
        }
        expect_punct("}");
        return st;
    }
    if tk == "KEYWORD" && tl == "trait" {
        // DEC-030: Trait(name) + firmas fn (sin cuerpo → Block vacío).
        let kln = t_line;
        let klc = t_col;   // loc del nodo = la keyword (p->previous.loc)
        advance();
        if tk != "IDENT" {
            ef("trait name");
            advance();
            return mk("PARSE-ERROR");
        }
        let nm = tl;
        advance();
        expect_punct("{");
        let mut tn: i64 = 0;
        if is_pub {
            tn = mk("PubTrait(" + nm + ")");
        } else {
            tn = mk("Trait(" + nm + ")");
        }
        set_loc(tn, kln, klc);
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if !(tk == "KEYWORD" && tl == "fn") {
                perr("only 'fn' items are supported in a trait");
                break;
            }
            let saved_self = allow_self;
            allow_self = true;
            let item = parse_fn(false, true);
            allow_self = saved_self;
            add_child(tn, item);
        }
        expect_punct("}");
        return tn;
    }
    if tk == "KEYWORD" && tl == "impl" {
        // DEC-030: Impl(Area for Punto) / Impl(Punto) — payload de texto
        // crudo; métodos con cuerpo (sig_only = false).
        let kln = t_line;
        let klc = t_col;   // loc del nodo = la keyword impl (p->previous.loc)
        if is_pub {
            perr("'pub' can only precede fn, struct, enum, trait or const");
        }
        advance();
        if tk != "IDENT" {
            ef("type name");
            advance();
            return mk("PARSE-ERROR");
        }
        let t1 = tl;
        advance();
        let mut head = t1;
        if tk == "KEYWORD" && tl == "for" {
            advance();
            if tk != "IDENT" {
                ef("type name");
                advance();
                return mk("PARSE-ERROR");
            }
            let t2 = tl;
            advance();
            head = t1 + " for " + t2;
        }
        expect_punct("{");
        let imn = mk("Impl(" + head + ")");
        set_loc(imn, kln, klc);
        while !(tk == "PUNCT" && tl == "}") && tk != "EOF" {
            if !(tk == "KEYWORD" && tl == "fn") {
                perr("only 'fn' items are supported in an impl block");
                break;
            }
            let saved_self = allow_self;
            allow_self = true;
            let item = parse_fn(false, false);
            allow_self = saved_self;
            add_child(imn, item);
        }
        expect_punct("}");
        return imn;
    }
    if tk == "KEYWORD" && tl == "use" {
        // DEC-030: el dump del seed imprime `Use` SIN payload (mirror lossy).
        if is_pub {
            perr("'pub' can only precede fn, struct, enum, trait or const");
        }
        advance();
        let path = parse_path_text();
        stmt_end();
        return mk("Use");
    }
    if tk == "KEYWORD" && tl == "import" {
        // DEC-030: Import(ruta) o Import(ruta as alias) con texto crudo.
        if is_pub {
            perr("'pub' can only precede fn, struct, enum, trait or const");
        }
        advance();
        let path = parse_path_text();
        let mut alias = "";
        if tk == "KEYWORD" && tl == "as" {
            advance();
            if tk != "IDENT" {
                ef("alias");
                advance();
                return mk("PARSE-ERROR");
            }
            alias = tl;
            advance();
        }
        stmt_end();
        if alias == "" {
            return mk("Import(" + path + ")");
        }
        return mk("Import(" + path + " as " + alias + ")");
    }
    if tk == "KEYWORD" && tl == "from" {
        // DEC-030: From(ruta) + ImportItem(n) / ImportItem(n as a).
        if is_pub {
            perr("'pub' can only precede fn, struct, enum, trait or const");
        }
        advance();
        let path = parse_path_text();
        if !(tk == "KEYWORD" && tl == "import") {
            ef("import");
            return mk("PARSE-ERROR");
        }
        advance();
        let fn_from = mk("From(" + path + ")");
        let mut done = false;
        while !done {
            if tk != "IDENT" {
                break;
            }
            let inm = tl;
            advance();
            let mut itext = "ImportItem(" + inm;
            if tk == "KEYWORD" && tl == "as" {
                advance();
                if tk != "IDENT" {
                    ef("alias");
                    advance();
                    return mk("PARSE-ERROR");
                }
                itext = itext + " as " + tl;
                advance();
            }
            itext = itext + ")";
            add_child(fn_from, mk(itext));
            if tk == "PUNCT" && tl == "," {
                advance();
                if tk != "IDENT" {
                    ef("import item");
                    done = true;
                }
            } else {
                done = true;
            }
        }
        if tree.first[fn_from] == 0 && tk == "EOF" {
            perr("expected at least one import item");
            return mk("PARSE-ERROR");
        }
        stmt_end();
        return fn_from;
    }
    if is_pub {
        perr("'pub' can only precede fn, struct, enum, trait or const");
    } else {
        perr("unexpected token in expression");
    }
    advance();
    mk("PARSE-ERROR")
}

fn parse_module() -> i64 {
    let root = mk("Module");
    while tk != "EOF" {
        // DEC-031: el seed acepta sentencias a nivel de módulo (toplevel
        // statements — conformance/module/toplevel_stmts; `foo bar` parsea
        // como dos idents, verificado e7) — no sólo items.
        if tk == "KEYWORD" && (tl == "fn" || tl == "struct" || tl == "const" || tl == "enum" || tl == "trait" || tl == "impl" || tl == "use" || tl == "import" || tl == "from" || tl == "pub") {
            add_child(root, parse_item());
        } else {
            add_child(root, parse_stmt());
        }
    }
    root
}

fn main() {
    src = read_file("parser_input.astra");
    slen = len(src);
    pos = 0;
    has_look = false;
    cur_line = 1;
    nln = 1;
    t_line = 1;
    t_col = 1;
    prev_line = 1;
    prev_col = 1;
    prev_len = 0;
    line_start = 0;
    advance();
    let root = parse_module();
    if err_count > 0 {
        // espejo del driver del seed (driver.c:668): sin dump, una línea
        // final `error: parse failed` (el gate de diagnósticos compara
        // salidas, no rc).
        print("error: parse failed");
    } else {
        print(render(root));
    }
}
