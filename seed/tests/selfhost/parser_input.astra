// parser_input.astra — fixture for the self-hosted parser gate (DEC-025,
// scope v2 by DEC-028).
//
// v2: statements end with NEWLINE — only a few keep ';' (both paths of the
// seed's optional_semi are covered); enum items; match with negative and
// or-patterns, a guard (parsed but omitted from the dump — the golden comes
// from --dump-ast), qualified variants with payload bindings, block arms and
// a statement-position match. No operators at end of line: the seed cuts
// the statement at the NEWLINE (DEC-028 §1).
// v2.1 (DEC-029): lambdas — |params| [-> type] { block }; param types and
// the -> ret annotation are parsed but only the ret shows up in the seed's
// dump; one lambda per accepted shape (typed+ret, untyped, multi, `| |`).
// v2.2 (DEC-030): items — use/import/from (module), struct + struct
// literal + field assign, trait (signature-only method), trait impl +
// inherent impl, pub fn; the struct-literal flag of the seed (no_struct_lit)
// keeps `if … {` / `match … {` from being read as literals.
// Same subset as v1 otherwise (see parser.astra's header for the limits).
use collections.list
import math.geom as g
from str.utils import trim, upper as up
const LIMIT = 10
enum Size {
    XS
    S
    L
}
fn add(a: i32, b: i32) -> i32 {
    let mut total: i32 = a + b;
    total = total * 2 + 1
    return total
}
fn classify(n: i32, s: Size) -> i32 {
    let r = match n {
        0 => 10,
        -5 => 15,
        1 | 2 => 20,
        _ if n > 90 => 30,
        _ => 40,
    };
    let t = match s {
        Size.XS => 1,
        Size.S => 2,
        Size.L => 3,
    }
    match t {
        0 => { print("zero"); },
        _ => { print(t); },
    }
    return r + t
}
struct Punto {
    x: i32
    y: i32
}

trait Area {
    fn area(self) -> i32
}

impl Area for Punto {
    fn area(self) -> i32 {
        self.x * self.y
    }
}

impl Punto {
    fn shift(self, d: i32) -> i32 {
        self.x + d
    }
}

pub fn extra(n: i32) -> i32 { n }

fn pick(n: i32) -> i32 {
    if n < 0 {
        return -n
    } else if n == 0 {
        return 0
    } else {
        return n
    }
}
fn main() {
    let name = "astra"
    let flag = true
    let arr = [1, 2, 3]
    let mut v = arr[1]
    let sum = add(pick(-5), LIMIT)
    if sum < 0 && flag || !flag {
        print(name)
    } else {
        print(sum)
    }
    while v < LIMIT {
        v = v + arr[0]
        if v == 4 { break }
    }
    let cls = classify(1, Size.S)
    print(cls)
    print(v % 2 == 0)
    let mut p = Punto { x: 4, y: 5 };
    p.x = 7
    print(p.area())
    print(p.shift(3))
    print(extra(7))
    let inc = |x: i32| -> i32 { x + 1 }
    let ident = |y| { y }
    let sum2 = |a: i32, b: i32| { a + b }
    let sev = | | -> i32 { 7 }
    print(inc(41))
    print(ident(7))
    print(sum2(40, 2))
    print(sev())
}
