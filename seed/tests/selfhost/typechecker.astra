// typechecker.astra — typechecker de Astra-0 auto-hospedado, milestone
// M-T3 (DEC-032: núcleo M-T2 + structs/enums/métodos/traits/match).
//
// Se CONCATENA con parser.astra sin su `main` (el gate lo construye):
//   sed '/^fn main()/,$d' parser.astra > pp.astra
//   cat pp.astra typechecker.astra > combined.astra
// Todas las funciones llevan prefijo `tc_` y las globales `tcv_` para que
// no colisione con las del parser (una colisión de nombre es un
// `duplicate function` ruidoso del typecheck del seed — DEC-032 §6-2).
//
// Verdad semántica: espejo byte a byte de seed/src/typechecker.c (los
// mensajes, sus argumentos y sus posiciones); las DEC ratificadas ya viven
// ahí. Alcance M-T3: el núcleo M-T2 + declaraciones nominales
// (struct/enum), literales y acceso a campos, construcción de variantes
// (DEC-008), métodos inherent/trait con conformance, y match con patrones,
// guardas y exhaustividad. Fuera de alcance (corpus excluido): optional/
// `?`/some/none (el parser no emite PATERN_BUILTIN_VARIANT ni `T?`),
// lambda (tipado pendiente), `for` (M-T4), genéricos, transfer/copy
// (ownership, DEC-026). `main` enciende `emit_guards` para que el parser
// emita la guarda de cada Arm (el route golden la sigue omitiendo: el dump
// del seed es mirror-lossy, PHASE2 §7).

// ---------- tipos (códigos fijos = type_kind_name del seed) ----------
// 1 void 2 bool 3 i32 4 i64 5 u32 6 u64 7 f64 8 string 9 nil 10 unknown
// 11 int_literal 12 array 13 optional 14 fn 15 struct 16 enum 17 error
struct Tp {
    kind: [i64]
    a: [i64]        // hijo: elem de array / inner de optional / primer param de fn
    nxt: [i64]      // hermano dentro de una lista (cadena de params)
    ret: [i64]      // tipo de retorno de fn (0 = ninguno)
    s: [string]     // nombre (struct/enum)
}
let mut tcv_tps = Tp { kind: [0], a: [0], nxt: [0], ret: [0], s: [""] }

// ---------- tabla de símbolos: plana + profundidad + generación ----------
struct Sym {
    names: [string]
    types: [i64]
    muts: [bool]
    fns: [bool]
    alive: [bool]
    depths: [i64]
    gens: [i64]
}
let mut tcv_syms = Sym { names: [""], types: [0], muts: [false], fns: [false], alive: [false], depths: [0], gens: [0] }
let mut tcv_depth: i64 = 0    // 0 = módulo; +1 por bloque
let mut tcv_gen: i64 = 0      // generación por fn (los locales de otra fn no se ven)
let mut tcv_fndepth: i64 = 0   // para `return outside of a function`
let mut tcv_errors: i64 = 0
let mut tcv_void: i64 = 0   // índice del tipo void (¡NO confundir con el kind 1!)
let mut tcv_ret: i64 = 0      // tipo de retorno anotado de la fn actual (0 = sin anotar)
let mut tcv_contret = false   // el cuerpo actual contiene un `return`

// ---------- tablas M-T3 (clones de declare_type_decls/checker_add_*) ----------
// Filas con centinela en 0 (como Sym): la fila 0 nunca es real.
// Campos de struct: owner = nombre nominal del struct.
struct Fld {
    owners: [string]
    names: [string]
    types: [i64]
}
let mut tcv_flds = Fld { owners: [""], names: [""], types: [0] }
// Variantes: registro plano (checker_add_variant) + índice dentro de su
// enum + payload (filas contiguas en tcv_pays desde pay0).
struct Var {
    enums: [string]
    names: [string]
    idxs: [i64]
    pay0: [i64]
    payn: [i64]
}
let mut tcv_vars = Var { enums: [""], names: [""], idxs: [0], pay0: [0], payn: [0] }
struct Pay {
    vars: [i64]     // fila en tcv_vars
    types: [i64]
}
let mut tcv_pays = Pay { vars: [0], types: [0] }
// Métodos: (tipo, nombre, trait) — trait "" = inherent.
struct Mth {
    types: [string]
    names: [string]
    traits: [string]
    fnt: [i64]      // fn type: params[0] = receptor
    locs: [i64]     // nodo fn (para el error de firma)
}
let mut tcv_mths = Mth { types: [""], names: [""], traits: [""], fnt: [0], locs: [0] }
struct Trt {
    names: [string]
}
let mut tcv_trts = Trt { names: [""] }
// Métodos requeridos de un trait: fnt SIN receptor (params = argumentos).
struct TrM {
    owners: [i64]   // fila en tcv_trts
    names: [string]
    fnt: [i64]
}
let mut tcv_trms = TrM { owners: [0], names: [""], fnt: [0] }
let mut tcv_recv: i64 = 0   // tipo receptor en cuerpos de métodos (0 = fn libre)

fn tc_kname(k: i64) -> string {
    if k == 1 { return "void"; }
    if k == 2 { return "bool"; }
    if k == 3 { return "i32"; }
    if k == 4 { return "i64"; }
    if k == 5 { return "u32"; }
    if k == 6 { return "u64"; }
    if k == 7 { return "f64"; }
    if k == 8 { return "string"; }
    if k == 9 { return "nil"; }
    if k == 10 { return "unknown"; }
    if k == 11 { return "integer literal"; }
    if k == 12 { return "array"; }
    if k == 13 { return "optional"; }
    if k == 14 { return "fn"; }
    if k == 15 { return "struct"; }
    if k == 16 { return "enum"; }
    if k == 17 { return "<error>"; }
    "<unknown>"
}

fn tc_mk(kind: i64) -> i64 {
    tcv_tps.kind = push(tcv_tps.kind, kind);
    tcv_tps.a = push(tcv_tps.a, 0);
    tcv_tps.nxt = push(tcv_tps.nxt, 0);
    tcv_tps.ret = push(tcv_tps.ret, 0);
    tcv_tps.s = push(tcv_tps.s, "");
    len(tcv_tps.kind) - 1
}

fn tc_prim(kind: i64) -> i64 {
    tc_mk(kind)
}

fn tc_array(elem: i64) -> i64 {
    let n = tc_mk(12);
    tcv_tps.a[n] = elem;
    n
}

fn tc_is_error(k: i64) -> bool {
    k == 17
}

fn tc_is_integer(k: i64) -> bool {
    k == 3 || k == 4 || k == 5 || k == 6 || k == 11
}

fn tc_is_numeric(k: i64) -> bool {
    tc_is_integer(k) || k == 7
}

// type_eq del seed (typechecker.c:48-85): unknown casa con todo; nil ≃
// optional; el literal entero adopta cualquier entero; tipos compuestos
// recursivos; escalares del mismo kind iguales.
fn tc_eq(a: i64, b: i64) -> bool {
    if a == 0 || b == 0 {
        return a == b;
    }
    let ka = tcv_tps.kind[a];
    let kb = tcv_tps.kind[b];
    if ka == 10 || kb == 10 {
        return true;
    }
    if (ka == 9 && kb == 13) || (kb == 9 && ka == 13) {
        return true;
    }
    if ka == 11 && kb != 11 {
        return tc_is_integer(kb);
    }
    if kb == 11 && ka != 11 {
        return tc_is_integer(ka);
    }
    if ka != kb {
        return false;
    }
    if ka == 12 {
        return tc_eq(tcv_tps.a[a], tcv_tps.a[b]);
    }
    if ka == 13 {
        return tc_eq(tcv_tps.a[a], tcv_tps.a[b]);
    }
    if ka == 14 {
        // params cadena por nxt + retorno
        let mut p1 = tcv_tps.a[a];
        let mut p2 = tcv_tps.a[b];
        while p1 != 0 && p2 != 0 {
            if !tc_eq(p1, p2) {
                return false;
            }
            p1 = tcv_tps.nxt[p1];
            p2 = tcv_tps.nxt[p2];
        }
        if p1 != 0 || p2 != 0 {
            return false;
        }
        let r1 = tcv_tps.ret[a];
        let r2 = tcv_tps.ret[b];
        if r1 == 0 && r2 == 0 {
            return true;
        }
        if r1 == 0 || r2 == 0 {
            return false;
        }
        return tc_eq(r1, r2);
    }
    if ka == 15 || ka == 16 {
        return tcv_tps.s[a] == tcv_tps.s[b];
    }
    true
}

// ---------- diagnósticos (mismo formato que tc_error del seed) ----------
fn tc_err(idx: i64, msg: string) {
    tcv_errors = tcv_errors + 1;
    print(file_name + ":" + to_string(tree.ln[idx]) + ":" + to_string(tree.co[idx]) + ": error: " + msg);
}

// ---------- scopes ----------
fn tc_lookup(name: string) -> i64 {
    // hacia atrás: el shadowing natural (la entrada nueva gana)
    let mut i = len(tcv_syms.names);
    while i > 0 {
        i = i - 1;
        if tcv_syms.alive[i] && tcv_syms.names[i] == name {
            if tcv_syms.depths[i] == 0 || tcv_syms.gens[i] == tcv_gen {
                return i;
            }
        }
    }
    -1
}

fn tc_declare(name: string, ty: i64, is_mut: bool, is_fn: bool) {
    tcv_syms.names = push(tcv_syms.names, name);
    tcv_syms.types = push(tcv_syms.types, ty);
    tcv_syms.muts = push(tcv_syms.muts, is_mut);
    tcv_syms.fns = push(tcv_syms.fns, is_fn);
    tcv_syms.alive = push(tcv_syms.alive, true);
    tcv_syms.depths = push(tcv_syms.depths, tcv_depth);
    tcv_syms.gens = push(tcv_syms.gens, tcv_gen);
}

fn tc_scope_enter() {
    tcv_depth = tcv_depth + 1;
}

fn tc_scope_exit() {
    tcv_depth = tcv_depth - 1;
    let mut i = len(tcv_syms.names);
    while i > 0 {
        i = i - 1;
        if tcv_syms.depths[i] > tcv_depth && tcv_syms.gens[i] == tcv_gen {
            tcv_syms.alive[i] = false;
        }
    }
}

// ---------- resolución de tipos desde TypeIdent(...) del parser ----------
fn tc_prim_from_name(nm: string) -> i64 {
    if nm == "void" { return 1; }
    if nm == "bool" { return 2; }
    if nm == "i32" { return 3; }
    if nm == "i64" { return 4; }
    if nm == "u32" { return 5; }
    if nm == "u64" { return 6; }
    if nm == "f64" { return 7; }
    if nm == "string" { return 8; }
    0
}

// payload de "TypeIdent(xxx)" -> xxx
fn tc_payload(text: string) -> string {
    let mut open: i64 = -1;
    let mut i: i64 = 0;
    while i < len(text) {
        if text[i] == "(" {
            open = i;
            i = len(text);
        } else {
            i = i + 1;
        }
    }
    if open < 0 {
        return "";
    }
    substr(text, open + 1, len(text) - open - 2)
}

fn tc_resolve_type(node: i64) -> i64 {
    // TypeIdent(nombre) -> primitiva; si no, el símbolo nominal que el
    // pass0 declaró (struct/enum — resolve_type_node del seed: symbol
    // lookup antes de "unknown type").
    let lab = knames[tree.kind[node]];
    if lab == "TypeIdent" {
        let nm = tc_payload(tree.text[node]);
        let k = tc_prim_from_name(nm);
        if k != 0 {
            return tc_prim(k);
        }
        let i = tc_lookup(nm);
        if i >= 0 {
            return tcv_syms.types[i];
        }
        tc_err(node, "unknown type '" + nm + "'");
        return tc_prim(17);
    }
    tc_err(node, "invalid type expression");
    tc_prim(17)
}

// ---------- números de literal (DEC-006) ----------
fn tc_lit_value(node: i64) -> i64 {
    // IntLit(n) o UnaryOp(- IntLit(n)) — devuelve el valor; -922... sin
    // marcar: sólo lo usamos con rangos y defaults.
    let lab = knames[tree.kind[node]];
    if lab == "IntLit" {
        // sólo dígitos (el lexer del parser los produce); fuera de rango i64
        // viene de ficheros que el lexer del seed rechaza (corpus excluido)
        return str_to_int(tc_payload(tree.text[node]));
    }
    if lab == "UnaryOp" && tree.text[node] == "UnaryOp(-)" {
        if tree.first[node] != 0 {
            let inner = tree.first[node];
            if knames[tree.kind[inner]] == "IntLit" {
                return -str_to_int(tc_payload(tree.text[inner]));
            }
        }
    }
    0
}

fn tc_lit_has_value(node: i64) -> bool {
    let lab = knames[tree.kind[node]];
    if lab == "IntLit" {
        return true;
    }
    if lab == "UnaryOp" && tree.text[node] == "UnaryOp(-)" && tree.first[node] != 0 {
        return knames[tree.kind[tree.first[node]]] == "IntLit";
    }
    false
}

// int_lit_fits del seed (typechecker.c:2823)
fn tc_fits(v: i64, k: i64) -> bool {
    if k == 3 {
        return v >= -2147483648 && v <= 2147483647;
    }
    if k == 5 {
        return v >= 0 && v <= 4294967295;
    }
    if k == 4 {
        return true;
    }
    if k == 6 {
        return v >= 0;
    }
    true
}

// default_int_type (DEC-006): i32, o i64 si no cabe
fn tc_default_int(init: i64) -> i64 {
    if tc_lit_has_value(init) {
        let v = tc_lit_value(init);
        if !tc_fits(v, 3) {
            return tc_prim(4);
        }
    }
    tc_prim(3)
}

// ---------- builtins (registro del seed: arity + retorno + param1) ----------
// (0 = unknown; el único param tipado es read_file: string)
fn tc_builtin(name: string) -> bool {
    name == "print" || name == "len" || name == "to_string" || name == "read_file" || name == "ord" || name == "substr" || name == "push" || name == "str_to_int" || name == "chr" || name == "read_line" || name == "transfer" || name == "copy"
}

fn tc_builtin_arity(name: string) -> i64 {
    if name == "push" { return 2; }
    if name == "substr" { return 3; }
    if name == "read_line" { return 0; }
    1
}

fn tc_builtin_ret(name: string) -> i64 {
    if name == "print" { return 1; }
    if name == "len" { return 4; }
    if name == "to_string" { return 8; }
    if name == "read_file" { return 8; }
    if name == "ord" { return 4; }
    if name == "substr" { return 8; }
    if name == "str_to_int" { return 4; }
    if name == "chr" { return 8; }
    if name == "read_line" { return 8; }
    17
}

fn tc_builtin_p1(name: string) -> i64 {
    if name == "read_file" { return 8; }
    0   // unknown
}

// push -> array<unknown>
fn tc_builtin_ret_node(name: string) -> i64 {
    if name == "push" {
        return tc_array(tc_prim(10));
    }
    tc_prim(tc_builtin_ret(name))
}

// ---------- node_contains_return (clone de typechecker.c:3099) ----------
fn tc_contains_return(node: i64) -> bool {
    if node == 0 {
        return false;
    }
    let lab = knames[tree.kind[node]];
    if lab == "Return" {
        return true;
    }
    if lab == "Block" || lab == "If" || lab == "While" || lab == "FnDecl" || lab == "PubFnDecl" {
        if lab == "FnDecl" || lab == "PubFnDecl" {
            return false;   // no atraviesa fn anidadas
        }
        let mut c = tree.first[node];
        while c != 0 {
            if tc_contains_return(c) {
                return true;
            }
            c = tree.next[c];
        }
        return false;
    }
    false
}

// ---------- expresiones (clones de typechecker.c §5) ----------
fn tc_arg_count(fn_t: i64) -> i64 {
    let mut n: i64 = 0;
    let mut p = tcv_tps.a[fn_t];
    while p != 0 {
        n = n + 1;
        p = tcv_tps.nxt[p];
    }
    n
}

fn tc_expr(node: i64) -> i64 {
    let lab = knames[tree.kind[node]];

    if lab == "IntLit" { return tc_prim(11); }
    if lab == "FloatLit" { return tc_prim(7); }
    if lab == "BoolLit" { return tc_prim(2); }
    if lab == "StringLit" { return tc_prim(8); }

    if lab == "Ident" {
        let name = tc_payload(tree.text[node]);
        let i = tc_lookup(name);
        if i < 0 {
            tc_err(node, "undefined variable '" + name + "'");
            return tc_prim(17);
        }
        return tcv_syms.types[i];
    }

    if lab == "UnaryOp" {
        // extraer el operador de "UnaryOp(X)" — prefijo = 8 chars
        let o = substr(tree.text[node], 8, len(tree.text[node]) - 8 - 1);
        let t = tc_expr(tree.first[node]);
        if tc_is_error(tcv_tps.kind[t]) { return t; }
        if o == "-" {
            if !tc_is_numeric(tcv_tps.kind[t]) {
                tc_err(node, "negation requires numeric type, got " + tc_kname(tcv_tps.kind[t]));
                return tc_prim(17);
            }
            return t;
        }
        if o == "!" {
            if tcv_tps.kind[t] != 2 {
                tc_err(node, "logical not requires bool, got " + tc_kname(tcv_tps.kind[t]));
                return tc_prim(17);
            }
            return tc_prim(2);
        }
        if o == "~" {
            if !tc_is_integer(tcv_tps.kind[t]) {
                tc_err(node, "bitwise not requires integer type, got " + tc_kname(tcv_tps.kind[t]));
                return tc_prim(17);
            }
            return t;
        }
        tc_err(node, "operator not supported in Astra-0");
        return tc_prim(17);
    }

    if lab == "BinaryOp" {
        let op = substr(tree.text[node], 9, len(tree.text[node]) - 9 - 1); // BinaryOp(+) -> +, prefijo 9 chars
        let l = tc_expr(tree.first[node]);
        let r = tc_expr(tree.next[tree.first[node]]);
        if tc_is_error(tcv_tps.kind[l]) { return l; }
        if tc_is_error(tcv_tps.kind[r]) { return r; }
        let lk = tcv_tps.kind[l];
        let rk = tcv_tps.kind[r];
        if op == "&&" || op == "||" {
            if lk != 2 {
                tc_err(tree.first[node], "logical operator requires bool, got " + tc_kname(lk));
                return tc_prim(17);
            }
            if rk != 2 {
                tc_err(tree.next[tree.first[node]], "logical operator requires bool, got " + tc_kname(rk));
                return tc_prim(17);
            }
            return tc_prim(2);
        }
        if op == "+" && lk == 8 && rk == 8 {
            return tc_prim(8);
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            if !tc_is_numeric(lk) {
                tc_err(tree.first[node], "arithmetic operator requires numeric type, got " + tc_kname(lk));
                return tc_prim(17);
            }
            if !tc_is_numeric(rk) {
                tc_err(tree.next[tree.first[node]], "arithmetic operator requires numeric type, got " + tc_kname(rk));
                return tc_prim(17);
            }
            if !tc_eq(l, r) {
                tc_err(node, "type mismatch: cannot apply '" + op + "' to " + tc_kname(lk) + " and " + tc_kname(rk));
                return tc_prim(17);
            }
            // numeric_result_type: si el izq es literal, adopta el der
            if lk == 11 { return r; }
            return l;
        }
        if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
            if !tc_eq(l, r) {
                tc_err(node, "type mismatch: cannot compare " + tc_kname(lk) + " and " + tc_kname(rk));
                return tc_prim(17);
            }
            return tc_prim(2);
        }
        if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
            if !tc_is_integer(lk) {
                tc_err(tree.first[node], "bitwise operator requires integer type, got " + tc_kname(lk));
                return tc_prim(17);
            }
            if !tc_is_integer(rk) {
                tc_err(tree.next[tree.first[node]], "bitwise operator requires integer type, got " + tc_kname(rk));
                return tc_prim(17);
            }
            if lk == 11 { return r; }
            return l;
        }
        tc_err(node, "operator not supported in Astra-0");
        return tc_prim(17);
    }

    if lab == "Call" {
        // clon de typecheck_call: variante pelada -> método/construcción ->
        // genérica -> callee normal.
        let callee = tree.first[node];
        // DEC-008: `Some2(1)` (variante de USUARIO en forma pelada) se
        // rechaza con la pista hacia la ortografía calificada.
        if knames[tree.kind[callee]] == "Ident" {
            let cname = tc_payload(tree.text[callee]);
            let vrow = tc_variant_any(cname);
            if vrow > 0 {
                let sym = tc_lookup(cname);
                let mut isfn = false;
                if sym >= 0 {
                    isfn = tcv_syms.fns[sym];
                }
                if !isfn {
                    tc_err(node, "use Enum.Variant to construct '" + cname + "'");
                    return tc_prim(17);
                }
            }
        }
        // `x.m(args)`: Enum.Variant(args) -> construcción; método -> firma
        // sin receptor; .copy() -> builtin (sin argumentos, receptor).
        if knames[tree.kind[callee]] == "FieldAccess" {
            let obj = tc_expr(tree.first[callee]);
            if tc_is_error(tcv_tps.kind[obj]) { return obj; }
            let field = tc_payload(tree.text[callee]);
            if tcv_tps.kind[obj] == 16 {
                let vrow = tc_variant_of(tcv_tps.s[obj], field);
                if vrow > 0 {
                    return tc_variant_construct(node, obj, vrow, field);
                }
            }
            let mrow = tc_find_method(obj, field);
            if mrow > 0 {
                return tc_method_call(node, mrow);
            }
            // sin método: cae al camino normal (el objeto ya tipó limpio,
            // así que su error — p.ej. "has no field" — sale sin duplicar)
        }
        let ct = tc_expr(callee);
        if tc_is_error(tcv_tps.kind[ct]) { return ct; }
        if tcv_tps.kind[ct] != 14 {
            tc_err(callee, "cannot call non-function type " + tc_kname(tcv_tps.kind[ct]));
            return tc_prim(17);
        }
        let want = tc_arg_count(ct);
        // recolectar args (cadena a partir del callee)
        let mut args: [i64] = [0];
        let mut n: i64 = 0;
        let mut c = tree.next[callee];
        while c != 0 {
            args = push(args, c);
            n = n + 1;
            c = tree.next[c];
        }
        if n != want {
            tc_err(node, "expected " + to_string(want) + " arguments, got " + to_string(n));
            return tc_prim(17);
        }
        let mut p = tcv_tps.a[ct];
        let mut i: i64 = 0;
        while i < n {
            let at = tc_expr(args[i + 1]);
            if tc_is_error(tcv_tps.kind[at]) { return at; }
            if !tc_eq(at, p) {
                tc_err(node, "argument " + to_string(i + 1) + ": expected " + tc_kname(tcv_tps.kind[p]) + ", got " + tc_kname(tcv_tps.kind[at]));
                return tc_prim(17);
            }
            p = tcv_tps.nxt[p];
            i = i + 1;
        }
        let ret = tcv_tps.ret[ct];
        if ret == 0 { return tc_prim(1); }
        return ret;
    }

    if lab == "Index" {
        let obj = tc_expr(tree.first[node]);
        if tc_is_error(tcv_tps.kind[obj]) { return obj; }
        let okk = tcv_tps.kind[obj];
        if okk != 12 && okk != 8 {
            tc_err(tree.first[node], "cannot index non-array type " + tc_kname(okk));
            return tc_prim(17);
        }
        let ix = tc_expr(tree.next[tree.first[node]]);
        if tc_is_error(tcv_tps.kind[ix]) { return ix; }
        if !tc_is_integer(tcv_tps.kind[ix]) {
            tc_err(tree.next[tree.first[node]], "array index must be integer type, got " + tc_kname(tcv_tps.kind[ix]));
            return tc_prim(17);
        }
        if okk == 8 { return tc_prim(8); }
        return tcv_tps.a[obj];
    }

    if lab == "FieldAccess" {
        // clon de typecheck_field_access: Enum.Variant (valor del enum),
        // campo de struct, método sin llamar, o error.
        let obj = tc_expr(tree.first[node]);
        if tc_is_error(tcv_tps.kind[obj]) { return obj; }
        let field = tc_payload(tree.text[node]);
        if tcv_tps.kind[obj] == 16 {
            if tc_variant_of(tcv_tps.s[obj], field) > 0 {
                return obj;
            }
            if tc_find_method(obj, field) > 0 {
                tc_err(node, "method '" + field + "' of '" + tcv_tps.s[obj] + "' must be called");
                return tc_prim(17);
            }
            tc_err(node, "enum '" + tcv_tps.s[obj] + "' has no variant '" + field + "'");
            return tc_prim(17);
        }
        if tcv_tps.kind[obj] != 15 {
            tc_err(tree.first[node], "cannot access field on non-struct type " + tc_kname(tcv_tps.kind[obj]));
            return tc_prim(17);
        }
        let ft = tc_find_fld(tcv_tps.s[obj], field);
        if ft > 0 {
            return ft;
        }
        if tc_find_method(obj, field) > 0 {
            tc_err(node, "method '" + field + "' of '" + tcv_tps.s[obj] + "' must be called");
            return tc_prim(17);
        }
        tc_err(node, "struct '" + tcv_tps.s[obj] + "' has no field '" + field + "'");
        return tc_prim(17);
    }

    if lab == "StructLit" {
        return tc_struct_lit(node);
    }

    if lab == "Match" {
        return tc_match(node);
    }

    if lab == "For" {
        return tc_for(node);
    }

    if lab == "Range" {
        tc_err(node, "range expression is only valid as a for-loop iterator");
        return tc_prim(17);
    }

    if lab == "ArrayLit" {
        let mut c = tree.first[node];
        if c == 0 {
            return tc_array(tc_prim(10)); // literal vacío: element unknown
        }
        let et = tc_expr(c);
        if tc_is_error(tcv_tps.kind[et]) { return et; }
        let mut i: i64 = 1;
        c = tree.next[c];
        while c != 0 {
            let t = tc_expr(c);
            if tc_is_error(tcv_tps.kind[t]) { return t; }
            if !tc_eq(t, et) {
                tc_err(c, "array element " + to_string(i + 1) + " has type " + tc_kname(tcv_tps.kind[t]) + ", expected " + tc_kname(tcv_tps.kind[et]));
                return tc_prim(17);
            }
            c = tree.next[c];
            i = i + 1;
        }
        return tc_array(et);
    }

    if lab == "If" {
        let cond = tc_expr(tree.first[node]);
        if tc_is_error(tcv_tps.kind[cond]) { return cond; }
        if tcv_tps.kind[cond] != 2 && tcv_tps.kind[cond] != 13 {
            tc_err(tree.first[node], "if condition must be bool, got " + tc_kname(tcv_tps.kind[cond]));
        }
        let then_t = tc_block_child(tree.next[tree.first[node]]);
        let else_child = tree.next[tree.next[tree.first[node]]];
        if else_child != 0 {
            let else_t = tc_block_child(else_child);
            if !tc_eq(then_t, else_t) {
                tc_err(node, "if branches have different types: " + tc_kname(tcv_tps.kind[then_t]) + " vs " + tc_kname(tcv_tps.kind[else_t]));
                return tc_prim(17);
            }
            return then_t;
        }
        return tc_prim(1);
    }

    if lab == "While" {
        let cond = tc_expr(tree.first[node]);
        if tc_is_error(tcv_tps.kind[cond]) { return cond; }
        if tcv_tps.kind[cond] != 2 {
            tc_err(tree.first[node], "while condition must be bool, got " + tc_kname(tcv_tps.kind[cond]));
        }
        tc_block_child(tree.next[tree.first[node]]);
        return tc_prim(1);
    }

    if lab == "Return" {
        let mut vt: i64 = tcv_void; // void
        if tree.first[node] != 0 {
            vt = tc_expr(tree.first[node]);
            if tc_is_error(tcv_tps.kind[vt]) { return vt; }
        }
        if tcv_fndepth == 0 {
            tc_err(node, "return outside of a function");
            return tc_prim(17);
        }
        if tcv_ret != 0 && !tc_eq(vt, tcv_ret) {
            tc_err(node, "return type " + tc_kname(tcv_tps.kind[vt]) + " does not match function return type " + tc_kname(tcv_tps.kind[tcv_ret]));
            return tc_prim(17);
        }
        return vt;
    }

    if lab == "Break" || lab == "Continue" {
        return tc_prim(1);
    }

    if lab == "Assign" {
        return tc_assign(node);
    }

    if lab == "Block" {
        return tc_block_child(node);
    }

    if lab == "Else" {
        // el nodo Else es transparente para el TIPO: el delimitador con
        // hijo Block/If (la cadena else-if mete un Block SIN marcar →
        // void → DEC-033 rechaza; el else con llaves marca la cola del
        // Block → tipado → acepta — t4 vs t7 verificados).
        return tc_expr(tree.first[node]);
    }

    // nodos M-T3+ (struct/enum/match/lambda/impl...) y comodines: unknown
    // (type_eq lo acepta con todo → sin falsos negativos en el corpus M-T2)
    if lab == "VarDecl" { return tc_var(node); }
    if lab == "ConstDecl" { return tc_const(node); }
    tc_prim(10)
}

// Bloque como valor (clon de typecheck_block): TODAS las sentencias menos
// la última se evalúan una vez; la última, si flg==1 (expresión final sin
// ';'), es la cola y se evalúa UNA sola vez como valor — t1..t7 y DEC-033.
fn tc_block_child(node: i64) -> i64 {
    let lab = knames[tree.kind[node]];
    if lab != "Block" {
        return tc_expr(node);
    }
    tc_scope_enter();
    // localizar el último hijo
    let mut last: i64 = 0;
    let mut c = tree.first[node];
    while c != 0 {
        last = c;
        c = tree.next[c];
    }
    // sentencias hasta el penúltimo
    c = tree.first[node];
    while c != 0 && c != last {
        tc_stmt(c);
        c = tree.next[c];
    }
    let mut vt: i64 = tcv_void;
    if last != 0 {
        if tree.flg[last] == 1 {
            vt = tc_expr(last);
        } else {
            tc_stmt(last);
        }
    }
    tc_scope_exit();
    vt
}

// sentencia sin valor: decls, fn anidadas y todo lo demás como expresión
fn tc_stmt(node: i64) {
    let l = knames[tree.kind[node]];
    if l == "VarDecl" {
        tc_var(node);
    } else if l == "ConstDecl" {
        tc_const(node);
    } else if l == "FnDecl" || l == "PubFnDecl" {
        tc_fn_body(node);
    } else if l == "StructDecl" || l == "PubStructDecl" {
        tc_struct_decl(node);   // decl anidada: tipo fresco (seed)
    } else if l == "EnumDecl" || l == "PubEnumDecl" {
        tc_enum_decl(node);
    } else {
        let ign = tc_expr(node);
    }
}

// nombre de declaración: "VarDecl(total, mut)" -> "total"; "FnDecl(add)" -> "add"
fn tc_decl_name(text: string) -> string {
    let payload = tc_payload(text);
    let mut i: i64 = 0;
    while i < len(payload) {
        if payload[i] == "," {
            return substr(payload, 0, i);
        }
        i = i + 1;
    }
    payload
}

fn tc_is_mut_decl(text: string) -> bool {
    // ", mut" dentro del payload
    let payload = tc_payload(text);
    let mut i: i64 = 0;
    while i + 5 <= len(payload) {
        if substr(payload, i, 5) == ", mut" {
            return true;
        }
        i = i + 1;
    }
    false
}

// primer hijo por etiqueta
fn tc_child_labeled(node: i64, want: string) -> i64 {
    let mut c = tree.first[node];
    while c != 0 {
        if knames[tree.kind[c]] == want {
            return c;
        }
        c = tree.next[c];
    }
    0
}

// ---------- M-T3: tablas nominales, métodos, traits, variantes ----------
// Clon de un tipo para encadenarlo como PARÁMETRO de fn: los tipos
// nominales (struct/enum) son NODOS COMPARTIDOS (el símbolo los devuelve
// tal cual), y la cadena de params escribe en nxt[prev] — enlazar dos
// parámetros del mismo struct haría nxt[P] = P (ciclo) y tc_arg_count
// colgaba (method_dispatch: `fn f(a: Point, b: Point)`). El seed no puede
// sufrirlo: sus params son un array, no una lista enlazada.
fn tc_chain_node(t: i64) -> i64 {
    if t == 0 { return 0; }
    let k = tcv_tps.kind[t];
    if k == 15 || k == 16 || k == 12 || k == 13 || k == 14 {
        let n = tc_mk(k);
        tcv_tps.a[n] = tcv_tps.a[t];
        tcv_tps.ret[n] = tcv_tps.ret[t];
        tcv_tps.s[n] = tcv_tps.s[t];
        return n;
    }
    t
}

fn tc_find_fld(sname: string, fname: string) -> i64 {
    let mut k: i64 = 1;
    while k < len(tcv_flds.owners) {
        if tcv_flds.owners[k] == sname && tcv_flds.names[k] == fname {
            return tcv_flds.types[k];
        }
        k = k + 1;
    }
    0
}

// fila de la variante V del enum E (calificada), o 0
fn tc_variant_of(ename: string, vname: string) -> i64 {
    let mut k: i64 = 1;
    while k < len(tcv_vars.names) {
        if tcv_vars.enums[k] == ename && tcv_vars.names[k] == vname {
            return k;
        }
        k = k + 1;
    }
    0
}

// primera fila de la variante V en CUALQUIER enum (registro plano del
// seed: sólo sirve para rechazar la forma pelona — DEC-008)
fn tc_variant_any(vname: string) -> i64 {
    let mut k: i64 = 1;
    while k < len(tcv_vars.names) {
        if tcv_vars.names[k] == vname {
            return k;
        }
        k = k + 1;
    }
    0
}

// nombre de la variante de índice vi del enum (para exhaustividad)
fn tc_variant_name(ename: string, vi: i64) -> string {
    let mut k: i64 = 1;
    while k < len(tcv_vars.names) {
        if tcv_vars.enums[k] == ename && tcv_vars.idxs[k] == vi {
            return tcv_vars.names[k];
        }
        k = k + 1;
    }
    "?"
}

// checker_find_method: inherent gana a trait sin importar el orden; entre
// traits gana el primero declarado (limitación documentada Phase 2.3).
fn tc_find_method(recv_t: i64, name: string) -> i64 {
    if recv_t == 0 { return 0; }
    let k = tcv_tps.kind[recv_t];
    if k != 15 && k != 16 { return 0; }
    let tn = tcv_tps.s[recv_t];
    let mut trait_row: i64 = 0;
    let mut i: i64 = 1;
    while i < len(tcv_mths.names) {
        if tcv_mths.names[i] == name && tcv_mths.types[i] == tn {
            if tcv_mths.traits[i] == "" {
                return i;
            }
            if trait_row == 0 {
                trait_row = i;
            }
        }
        i = i + 1;
    }
    trait_row
}

// checker_find_trait_method: (tipo, nombre, trait) exacto, sin fallback
fn tc_find_trait_method(tname: string, mname: string, trname: string) -> i64 {
    let mut i: i64 = 1;
    while i < len(tcv_mths.names) {
        if tcv_mths.types[i] == tname && tcv_mths.names[i] == mname && tcv_mths.traits[i] == trname {
            return i;
        }
        i = i + 1;
    }
    0
}

// check_variant_construction (typechecker.c:1809): arity + tipos, posición
//ales; el resultado es el tipo del enum.
fn tc_variant_construct(node: i64, et: i64, vrow: i64, vname: string) -> i64 {
    let callee = tree.first[node];
    let mut n: i64 = 0;
    let mut c = tree.next[callee];
    let mut first_arg: i64 = 0;
    if c != 0 { first_arg = c; }
    while c != 0 {
        n = n + 1;
        c = tree.next[c];
    }
    let nf = tcv_vars.payn[vrow];
    if n != nf {
        tc_err(node, "variant '" + tcv_tps.s[et] + "." + vname + "' expects " + to_string(nf) + " field(s), got " + to_string(n));
        return tc_prim(17);
    }
    if nf > 0 {
        let mut i: i64 = 0;
        let mut c2 = first_arg;
        while i < n {
            let at = tc_expr(c2);
            if tc_is_error(tcv_tps.kind[at]) { return at; }
            let expected = tcv_pays.types[tcv_vars.pay0[vrow] + i];
            if expected != 0 && tcv_tps.kind[expected] != 10 && !tc_eq(at, expected) {
                tc_err(node, "field " + to_string(i + 1) + " of '" + tcv_tps.s[et] + "." + vname + "' expects " + tc_kname(tcv_tps.kind[expected]) + ", got " + tc_kname(tcv_tps.kind[at]));
                return tc_prim(17);
            }
            c2 = tree.next[c2];
            i = i + 1;
        }
    }
    et
}

// typecheck_method_call: el receptor no es argumento de origen
fn tc_method_call(node: i64, mrow: i64) -> i64 {
    let fn_t = tcv_mths.fnt[mrow];
    let want = tc_arg_count(fn_t) - 1;
    let mut n: i64 = 0;
    let mut c = tree.next[tree.first[node]];
    let mut first_arg: i64 = 0;
    if c != 0 { first_arg = c; }
    while c != 0 {
        n = n + 1;
        c = tree.next[c];
    }
    if n != want {
        tc_err(node, "expected " + to_string(want) + " arguments, got " + to_string(n));
        return tc_prim(17);
    }
    let mut p = tcv_tps.nxt[tcv_tps.a[fn_t]];
    let mut i: i64 = 0;
    let mut c2 = first_arg;
    while i < n {
        let at = tc_expr(c2);
        if tc_is_error(tcv_tps.kind[at]) { return at; }
        if !tc_eq(at, p) {
            tc_err(node, "argument " + to_string(i + 1) + ": expected " + tc_kname(tcv_tps.kind[p]) + ", got " + tc_kname(tcv_tps.kind[at]));
            return tc_prim(17);
        }
        p = tcv_tps.nxt[p];
        c2 = tree.next[c2];
        i = i + 1;
    }
    let ret = tcv_tps.ret[fn_t];
    if ret == 0 { return tc_prim(1); }
    ret
}

// typecheck_struct_lit: duplicados -> desconocidos -> cada campo declarado
// exactamente una vez con tipo compatible (typechecker.c:2052).
fn tc_struct_lit(node: i64) -> i64 {
    let name = tc_payload(tree.text[node]);
    let mut st: i64 = 0;
    let i = tc_lookup(name);
    if i >= 0 {
        st = tcv_syms.types[i];
    }
    if st == 0 || tcv_tps.kind[st] != 15 {
        tc_err(node, "unknown struct '" + name + "'");
        return tc_prim(17);
    }
    let mut fnames: [string] = [""];
    let mut fvals: [i64] = [0];
    let mut nf: i64 = 0;
    let mut c = tree.first[node];
    while c != 0 {
        fnames = push(fnames, tc_payload(tree.text[c]));
        fvals = push(fvals, tree.first[c]);
        nf = nf + 1;
        c = tree.next[c];
    }
    let mut i2: i64 = 1;
    while i2 <= nf {
        let fname = fnames[i2];
        let mut j: i64 = 1;
        while j < i2 {
            if fnames[j] == fname {
                tc_err(node, "duplicate field '" + fname + "' in struct literal");
                return tc_prim(17);
            }
            j = j + 1;
        }
        if tc_find_fld(name, fname) == 0 {
            tc_err(node, "struct '" + name + "' has no field '" + fname + "'");
            return tc_prim(17);
        }
        i2 = i2 + 1;
    }
    let mut k: i64 = 1;
    while k < len(tcv_flds.owners) {
        if tcv_flds.owners[k] == name {
            let fname = tcv_flds.names[k];
            let mut vi: i64 = -1;
            let mut j: i64 = 1;
            while j <= nf {
                if fnames[j] == fname {
                    vi = j;
                }
                j = j + 1;
            }
            if vi < 0 {
                tc_err(node, "missing field '" + fname + "' in '" + name + "' literal");
                return tc_prim(17);
            }
            let vt = tc_expr(fvals[vi]);
            if tc_is_error(tcv_tps.kind[vt]) { return vt; }
            let expected = tcv_flds.types[k];
            if !tc_eq(expected, vt) {
                tc_err(fvals[vi], "field '" + fname + "' expects " + tc_kname(tcv_tps.kind[expected]) + ", got " + tc_kname(tcv_tps.kind[vt]));
                return tc_prim(17);
            }
        }
        k = k + 1;
    }
    st
}

// check_pattern (typechecker.c:2357). Devuelve 1 si el patrón es un
// wildcard (el caller lo traduce en has_wildcard); la cobertura se marca
// en tcv_covered (global: los parámetros no son mut).
let mut tcv_covered: [bool] = [false]

fn tc_check_pattern(pat: i64, target: i64, covn: i64, mark: bool) -> i64 {
    if pat == 0 { return 0; }
    let lab = knames[tree.kind[pat]];
    if lab == "PatternWildcard" {
        return 1;
    }
    if lab == "PatternOr" {
        let mut w: i64 = 0;
        let mut c = tree.first[pat];
        while c != 0 {
            if tc_check_pattern(c, target, covn, mark) == 1 {
                w = 1;
            }
            c = tree.next[c];
        }
        return w;
    }
    if lab == "FieldAccess" {
        let obj = tree.first[pat];
        if obj == 0 || knames[tree.kind[obj]] != "Ident" {
            tc_err(pat, "pattern must be a literal, `_` or Enum.Variant");
            return 0;
        }
        let et = tc_expr(obj);
        if tc_is_error(tcv_tps.kind[et]) { return 0; }
        if tcv_tps.kind[et] != 16 {
            tc_err(pat, "pattern must be a literal, `_` or Enum.Variant");
            return 0;
        }
        if !tc_eq(et, target) {
            tc_err(pat, "pattern type " + tc_kname(tcv_tps.kind[et]) + " does not match match target type " + tc_kname(tcv_tps.kind[target]));
            return 0;
        }
        let vname = tc_payload(tree.text[pat]);
        let vrow = tc_variant_of(tcv_tps.s[et], vname);
        if vrow == 0 {
            tc_err(pat, "enum '" + tcv_tps.s[et] + "' has no variant '" + vname + "'");
            return 0;
        }
        if mark && tcv_vars.idxs[vrow] < covn {
            tcv_covered[tcv_vars.idxs[vrow]] = true;
        }
        return 0;
    }
    if lab == "IntLit" || lab == "FloatLit" || lab == "StringLit" || lab == "BoolLit" || lab == "UnaryOp" {
        let pt = tc_expr(pat);
        if tc_is_error(tcv_tps.kind[pt]) { return 0; }
        if !tc_eq(pt, target) {
            tc_err(pat, "pattern type " + tc_kname(tcv_tps.kind[pt]) + " does not match match target type " + tc_kname(tcv_tps.kind[target]));
            return 0;
        }
        if lab == "BoolLit" && mark && tcv_tps.kind[target] == 2 && covn > 1 {
            if tc_payload(tree.text[pat]) == "true" {
                tcv_covered[1] = true;
            } else {
                tcv_covered[0] = true;
            }
        }
        return 0;
    }
    if lab == "PatternBind" {
        tc_declare(tc_payload(tree.text[pat]), target, false, false);
        return 0;
    }
    if lab == "PatternVariantBind" {
        let vp = tree.first[pat];
        if vp == 0 || knames[tree.kind[vp]] != "FieldAccess" {
            tc_err(pat, "pattern must be a literal, `_` or Enum.Variant");
            return 0;
        }
        let obj = tree.first[vp];
        if obj == 0 || knames[tree.kind[obj]] != "Ident" {
            tc_err(pat, "pattern must be a literal, `_` or Enum.Variant");
            return 0;
        }
        let et = tc_expr(obj);
        if tc_is_error(tcv_tps.kind[et]) { return 0; }
        if tcv_tps.kind[et] != 16 {
            tc_err(pat, "pattern must be a literal, `_` or Enum.Variant");
            return 0;
        }
        if !tc_eq(et, target) {
            tc_err(pat, "pattern type " + tc_kname(tcv_tps.kind[et]) + " does not match match target type " + tc_kname(tcv_tps.kind[target]));
            return 0;
        }
        let vname = tc_payload(tree.text[vp]);
        let vrow = tc_variant_of(tcv_tps.s[et], vname);
        if vrow == 0 {
            tc_err(pat, "enum '" + tcv_tps.s[et] + "' has no variant '" + vname + "'");
            return 0;
        }
        if mark && tcv_vars.idxs[vrow] < covn {
            tcv_covered[tcv_vars.idxs[vrow]] = true;
        }
        let mut binds: [i64] = [0];
        let mut nb: i64 = 0;
        let mut c = tree.next[vp];
        while c != 0 {
            binds = push(binds, c);
            nb = nb + 1;
            c = tree.next[c];
        }
        if tcv_vars.payn[vrow] > 0 {
            if nb != tcv_vars.payn[vrow] {
                tc_err(pat, "variant '" + vname + "' has " + to_string(tcv_vars.payn[vrow]) + " fields but pattern binds " + to_string(nb));
                return 0;
            }
            let mut i: i64 = 0;
            while i < nb {
                tc_declare(tc_payload(tree.text[binds[i + 1]]), tcv_pays.types[tcv_vars.pay0[vrow] + i], false, false);
                i = i + 1;
            }
        } else {
            if nb > 0 {
                tc_err(pat, "variant '" + vname + "' has no payload but pattern binds " + to_string(nb));
                return 0;
            }
        }
        return 0;
    }
    tc_err(pat, "unsupported pattern in match arm");
    0
}

// typecheck_match (typechecker.c:2522): patrones, guardas, unificación de
// brazos y exhaustividad (enum/optional/bool/ resto -> '_').
fn tc_match(node: i64) -> i64 {
    let target = tc_expr(tree.first[node]);
    if tc_is_error(tcv_tps.kind[target]) { return target; }
    let tgt = tcv_tps.kind[target];
    let mut covn: i64 = 0;
    if tgt == 16 {
        covn = tcv_tps.a[target];
    } else if tgt == 13 || tgt == 2 {
        covn = 2;
    }
    tcv_covered = [false];
    let mut i: i64 = 1;
    while i < covn {
        tcv_covered = push(tcv_covered, false);
        i = i + 1;
    }
    let mut has_wildcard = false;
    let mut rty: i64 = 0;
    let mut c = tree.next[tree.first[node]];
    while c != 0 {
        tc_scope_enter();
        let pat = tree.first[c];
        let mut lastc: i64 = 0;
        let mut w = tree.first[c];
        while w != 0 {
            lastc = w;
            w = tree.next[w];
        }
        let mut guard: i64 = 0;
        if tree.next[pat] != lastc {
            guard = tree.next[pat];
        }
        // una guarda no satisface cobertura (audit §3.4); un binding sin
        // guarda cubre todo como `_` (audit §3.4 / bind_catch_all)
        if guard != 0 {
            let wc = tc_check_pattern(pat, target, covn, false);
        } else {
            let wc = tc_check_pattern(pat, target, covn, true);
            if wc == 1 {
                has_wildcard = true;
            }
            if knames[tree.kind[pat]] == "PatternBind" {
                has_wildcard = true;
            }
        }
        if guard != 0 {
            let g = tc_expr(guard);
            if !tc_is_error(tcv_tps.kind[g]) && tcv_tps.kind[g] != 2 {
                tc_err(guard, "match guard must be bool, got " + tc_kname(tcv_tps.kind[g]));
            }
        }
        let arm_t = tc_expr(lastc);
        if rty == 0 {
            rty = arm_t;
        } else if !tc_eq(arm_t, rty) {
            tc_err(lastc, "match arm type " + tc_kname(tcv_tps.kind[arm_t]) + " does not match previous arm type " + tc_kname(tcv_tps.kind[rty]));
        }
        tc_scope_exit();
        c = tree.next[c];
    }
    if !has_wildcard {
        if tgt == 16 {
            let mut vi: i64 = 0;
            while vi < covn {
                if !tcv_covered[vi] {
                    tc_err(node, "non-exhaustive match: missing variant '" + tcv_tps.s[target] + "." + tc_variant_name(tcv_tps.s[target], vi) + "'");
                }
                vi = vi + 1;
            }
        } else if tgt == 13 {
            if !tcv_covered[0] {
                tc_err(node, "non-exhaustive match: missing payload arm (some/ok/err)");
            }
            if covn > 1 && !tcv_covered[1] {
                tc_err(node, "non-exhaustive match: missing 'none' arm");
            }
        } else if tgt == 2 {
            if !tcv_covered[0] {
                tc_err(node, "non-exhaustive match: missing 'false' arm");
            }
            if covn > 1 && !tcv_covered[1] {
                tc_err(node, "non-exhaustive match: missing 'true' arm");
            }
        } else if !tc_is_error(tgt) {
            tc_err(node, "non-exhaustive match: missing '_' arm");
        }
    }
    if rty == 0 {
        return tc_prim(1);
    }
    rty
}

// typecheck_struct_decl (typechecker.c:3204): rellena los campos del tipo
// nominal que el pass0 declaró (o crea uno fresco si es anidado).
fn tc_struct_decl(node: i64) {
    let name = tc_payload(tree.text[node]);
    let mut st: i64 = 0;
    let i = tc_lookup(name);
    if i >= 0 && tcv_tps.kind[tcv_syms.types[i]] == 15 {
        st = tcv_syms.types[i];
    } else {
        st = tc_mk(15);
        tcv_tps.s[st] = name;
        tc_declare(name, st, false, false);
    }
    let mut c = tree.first[node];
    while c != 0 {
        if knames[tree.kind[c]] == "Field" {
            let fname = tc_payload(tree.text[c]);
            let mut k: i64 = 1;
            while k < len(tcv_flds.owners) {
                if tcv_flds.owners[k] == name && tcv_flds.names[k] == fname {
                    tc_err(node, "duplicate field '" + fname + "' in struct '" + name + "'");
                    break;
                }
                k = k + 1;
            }
            let tnode = tc_child_labeled(c, "TypeIdent");
            let mut ft: i64 = 10;
            if tnode != 0 {
                ft = tc_resolve_type(tnode);
            }
            if tc_is_error(tcv_tps.kind[ft]) {
                return;
            }
            tcv_flds.owners = push(tcv_flds.owners, name);
            tcv_flds.names = push(tcv_flds.names, fname);
            tcv_flds.types = push(tcv_flds.types, ft);
        }
        c = tree.next[c];
    }
}

// typecheck_enum_decl (typechecker.c:3280): variantes + payloads + el
// registro plano que rechaza la construcción pelada (DEC-008).
fn tc_enum_decl(node: i64) {
    let name = tc_payload(tree.text[node]);
    let mut en: i64 = 0;
    let i = tc_lookup(name);
    if i >= 0 && tcv_tps.kind[tcv_syms.types[i]] == 16 {
        en = tcv_syms.types[i];
    } else {
        en = tc_mk(16);
        tcv_tps.s[en] = name;
        tc_declare(name, en, false, false);
    }
    let mut vi: i64 = 0;
    let mut c = tree.first[node];
    while c != 0 {
        if knames[tree.kind[c]] == "Variant" {
            let vn = tc_payload(tree.text[c]);
            let mut k: i64 = 1;
            let mut dup = false;
            while k < len(tcv_vars.names) {
                if tcv_vars.enums[k] == name && tcv_vars.names[k] == vn {
                    dup = true;
                }
                k = k + 1;
            }
            if dup {
                tc_err(node, "duplicate variant '" + vn + "' in enum '" + name + "'");
            }
            tcv_vars.enums = push(tcv_vars.enums, name);
            tcv_vars.names = push(tcv_vars.names, vn);
            tcv_vars.idxs = push(tcv_vars.idxs, vi);
            let pay0 = len(tcv_pays.types);
            tcv_vars.pay0 = push(tcv_vars.pay0, pay0);
            let mut pn: i64 = 0;
            let mut f = tree.first[c];
            while f != 0 {
                if knames[tree.kind[f]] == "Field" {
                    let tn = tc_child_labeled(f, "TypeIdent");
                    let mut pt: i64 = 10;
                    if tn != 0 {
                        pt = tc_resolve_type(tn);
                    }
                    if tc_is_error(tcv_tps.kind[pt]) {
                        return;
                    }
                    tcv_pays.vars = push(tcv_pays.vars, len(tcv_vars.names) - 1);
                    tcv_pays.types = push(tcv_pays.types, pt);
                    pn = pn + 1;
                }
                f = tree.next[f];
            }
            tcv_vars.payn = push(tcv_vars.payn, pn);
            vi = vi + 1;
        }
        c = tree.next[c];
    }
    tcv_tps.a[en] = vi;   // variant_count (sólo meaningful para kind 16)
}

// collect_trait_decls (typechecker.c:3419): firmas requeridas; un cuerpo
// es un default method (rechazado).
fn tc_collect_trait(node: i64) {
    let name = tc_payload(tree.text[node]);
    tcv_trts.names = push(tcv_trts.names, name);
    let tri = len(tcv_trts.names) - 1;
    let mut c = tree.first[node];
    while c != 0 {
        let l = knames[tree.kind[c]];
        if l == "FnDecl" || l == "PubFnDecl" {
            let body = tc_child_labeled(c, "Block");
            if body != 0 && tree.first[body] != 0 {
                tc_err(c, "default trait methods are not yet supported");
            }
            let mname = tc_decl_name(tree.text[c]);
            let fn_t = tc_mk(14);
            let mut first: i64 = 0;
            let mut prev: i64 = 0;
            let mut seen: i64 = 0;
            let mut bad = false;
            let mut p = tree.first[c];
            while p != 0 && !bad {
                if knames[tree.kind[p]] == "Param" {
                    seen = seen + 1;
                    if seen > 1 {
                        let tn = tc_child_labeled(p, "TypeIdent");
                        let mut pt: i64 = 10;
                        if tn != 0 {
                            pt = tc_chain_node(tc_resolve_type(tn));
                        }
                        if tc_is_error(tcv_tps.kind[pt]) {
                            bad = true;
                        }
                        if prev == 0 {
                            first = pt;
                        } else {
                            tcv_tps.nxt[prev] = pt;
                        }
                        prev = pt;
                    }
                }
                p = tree.next[p];
            }
            tcv_tps.a[fn_t] = first;
            let ret_node = tc_child_labeled(c, "ReturnType");
            if ret_node != 0 {
                let inner = tc_child_labeled(ret_node, "TypeIdent");
                if inner != 0 {
                    let rr = tc_resolve_type(inner);
                    if tc_is_error(tcv_tps.kind[rr]) {
                        bad = true;
                    }
                    tcv_tps.ret[fn_t] = rr;
                }
            }
            if !bad {
                tcv_trms.owners = push(tcv_trms.owners, tri);
                tcv_trms.names = push(tcv_trms.names, mname);
                tcv_trms.fnt = push(tcv_trms.fnt, fn_t);
            }
        }
        c = tree.next[c];
    }
}

// receptor de un impl: nodo y tipo (para el pass2 de los cuerpos)
let mut tcv_implnodes: [i64] = [0]
let mut tcv_implrecvs: [i64] = [0]

// typecheck de UN método del impl: self anotado == receptor; firma con
// params[0] = receptor; registro con duplicado (typechecker.c:3560).
fn tc_impl_method(fn_node: i64, recv: i64, tname: string, trname: string) {
    let nm = tc_decl_name(tree.text[fn_node]);
    let mut firstp: i64 = 0;
    let mut nparams: i64 = 0;
    let mut c = tree.first[fn_node];
    while c != 0 {
        if knames[tree.kind[c]] == "Param" {
            if firstp == 0 {
                firstp = c;
            }
            nparams = nparams + 1;
        }
        c = tree.next[c];
    }
    if firstp == 0 || nparams == 0 {
        return;   // el parser ya reportó
    }
    let self_ann = tc_child_labeled(firstp, "TypeIdent");
    if self_ann != 0 {
        let ann = tc_resolve_type(self_ann);
        if !tc_is_error(tcv_tps.kind[ann]) && !tc_eq(ann, recv) {
            tc_err(fn_node, "type of 'self' must be '" + tname + "'");
        }
    }
    let fn_t = tc_mk(14);
    // El clon va en una variable local: `tcv_tps.a[fn_t] = tc_chain_node(..)`
    // evaluaría la RHS (que hace push y REEMPLAZA el array) con la base del
    // destino ya capturada — la escritura caería en el array huérfano.
    let recvc = tc_chain_node(recv);
    tcv_tps.a[fn_t] = recvc;
    let mut prev: i64 = recvc;
    let mut seen: i64 = 0;
    let mut bad = false;
    c = tree.first[fn_node];
    while c != 0 && !bad {
        if knames[tree.kind[c]] == "Param" {
            seen = seen + 1;
            if seen > 1 {
                let tn = tc_child_labeled(c, "TypeIdent");
                let mut pt: i64 = 10;
                if tn != 0 {
                    pt = tc_chain_node(tc_resolve_type(tn));
                }
                if tc_is_error(tcv_tps.kind[pt]) {
                    bad = true;
                }
                tcv_tps.nxt[prev] = pt;
                prev = pt;
            }
        }
        c = tree.next[c];
    }
    let ret_node = tc_child_labeled(fn_node, "ReturnType");
    if ret_node != 0 {
        let inner = tc_child_labeled(ret_node, "TypeIdent");
        if inner != 0 {
            let rr = tc_resolve_type(inner);
            if tc_is_error(tcv_tps.kind[rr]) {
                bad = true;
            }
            tcv_tps.ret[fn_t] = rr;
        }
    }
    if bad {
        return;
    }
    let mut i: i64 = 1;
    while i < len(tcv_mths.names) {
        if tcv_mths.types[i] == tname && tcv_mths.names[i] == nm && tcv_mths.traits[i] == trname {
            tc_err(fn_node, "method '" + nm + "' is already defined for type '" + tname + "'");
            return;
        }
        i = i + 1;
    }
    tcv_mths.types = push(tcv_mths.types, tname);
    tcv_mths.names = push(tcv_mths.names, nm);
    tcv_mths.traits = push(tcv_mths.traits, trname);
    tcv_mths.fnt = push(tcv_mths.fnt, fn_t);
    tcv_mths.locs = push(tcv_mths.locs, fn_node);
}

// typecheck_module_pass / impl (typechecker.c:3500-3700): receptor, pasada
// de métodos y conformance trait.
fn tc_impl(node: i64) {
    let head = tc_payload(tree.text[node]);
    let mut tname = head;
    let mut trname = "";
    let mut sp: i64 = -1;
    let mut i: i64 = 0;
    while i + 5 <= len(head) {
        if substr(head, i, 5) == " for " {
            sp = i;
            i = len(head);
        } else {
            i = i + 1;
        }
    }
    if sp >= 0 {
        trname = substr(head, 0, sp);
        tname = substr(head, sp + 5, len(head) - sp - 5);
    }
    let mut recv: i64 = 0;
    let k = tc_prim_from_name(tname);
    if k != 0 {
        recv = tc_prim(k);
    } else {
        let si = tc_lookup(tname);
        if si >= 0 {
            recv = tcv_syms.types[si];
        }
    }
    if recv == 0 {
        tc_err(node, "unknown type '" + tname + "'");
        return;
    }
    if tcv_tps.kind[recv] != 15 && tcv_tps.kind[recv] != 16 {
        tc_err(node, "impl requires a struct or enum type, got " + tc_kname(tcv_tps.kind[recv]));
        return;
    }
    tcv_implnodes = push(tcv_implnodes, node);
    tcv_implrecvs = push(tcv_implrecvs, recv);
    let mut c = tree.first[node];
    while c != 0 {
        let l = knames[tree.kind[c]];
        if l == "FnDecl" || l == "PubFnDecl" {
            tc_impl_method(c, recv, tname, trname);
        }
        c = tree.next[c];
    }
    if trname != "" {
        let mut tri: i64 = 0;
        let mut t: i64 = 1;
        while t < len(tcv_trts.names) {
            if tcv_trts.names[t] == trname {
                tri = t;
            }
            t = t + 1;
        }
        if tri == 0 {
            tc_err(node, "unknown trait '" + trname + "'");
            return;
        }
        let mut m: i64 = 1;
        while m < len(tcv_trms.owners) {
            if tcv_trms.owners[m] == tri {
                let mname = tcv_trms.names[m];
                let mrow = tc_find_trait_method(tname, mname, trname);
                if mrow == 0 {
                    tc_err(node, "type '" + tname + "' does not implement trait '" + trname + "': missing method '" + mname + "'");
                } else {
                    let mt = tcv_mths.fnt[mrow];
                    let tt = tcv_trms.fnt[m];
                    let mut sig_ok = tc_arg_count(mt) == tc_arg_count(tt) + 1;
                    let mut p1 = tcv_tps.a[tt];
                    let mut p2 = tcv_tps.nxt[tcv_tps.a[mt]];
                    while sig_ok && p1 != 0 && p2 != 0 {
                        if !tc_eq(p1, p2) {
                            sig_ok = false;
                        }
                        p1 = tcv_tps.nxt[p1];
                        p2 = tcv_tps.nxt[p2];
                    }
                    if sig_ok && (p1 != 0 || p2 != 0) {
                        sig_ok = false;
                    }
                    if sig_ok {
                        let mut ivt: i64 = tcv_void;
                        if tcv_tps.ret[mt] != 0 {
                            ivt = tcv_tps.ret[mt];
                        }
                        let mut trt: i64 = tcv_void;
                        if tcv_tps.ret[tt] != 0 {
                            trt = tcv_tps.ret[tt];
                        }
                        if !tc_eq(ivt, trt) {
                            sig_ok = false;
                        }
                    }
                    if !sig_ok {
                        tc_err(tcv_mths.locs[mrow], "signature of method '" + mname + "' of '" + tname + "' does not match trait '" + trname + "'");
                    }
                }
            }
            m = m + 1;
        }
    }
}

// typecheck_for (typechecker.c:2255): rangos con bounds enteros (fin
// abierto rechazado) o iterador array/string; la variable vive en su
// propio scope.
fn tc_for(node: i64) -> i64 {
    let iter_node = tree.first[node];
    let mut var_t: i64 = 0;
    if knames[tree.kind[iter_node]] == "Range" {
        let start = tree.first[iter_node];
        let end = tree.next[start];
        if end == 0 {
            tc_err(iter_node, "open-ended ranges are not supported in Astra-0");
            return tc_prim(17);
        }
        let st = tc_expr(start);
        if tc_is_error(tcv_tps.kind[st]) { return st; }
        if !tc_is_integer(tcv_tps.kind[st]) {
            tc_err(start, "range start must be integer type, got " + tc_kname(tcv_tps.kind[st]));
            return tc_prim(17);
        }
        let et = tc_expr(end);
        if tc_is_error(tcv_tps.kind[et]) { return et; }
        if !tc_is_integer(tcv_tps.kind[et]) {
            tc_err(end, "range end must be integer type, got " + tc_kname(tcv_tps.kind[et]));
            return tc_prim(17);
        }
        var_t = tc_prim(3);
    } else {
        let iter = tc_expr(iter_node);
        if tc_is_error(tcv_tps.kind[iter]) { return iter; }
        let ik = tcv_tps.kind[iter];
        if ik != 12 && ik != 8 {
            tc_err(iter_node, "for loop must iterate over an array, string or range, got " + tc_kname(ik));
            return tc_prim(17);
        }
        if ik == 8 {
            var_t = tc_prim(8);
        } else {
            var_t = tcv_tps.a[iter];
        }
    }
    tc_scope_enter();
    tc_declare(tc_payload(tree.text[node]), var_t, false, false);
    tc_block_child(tree.next[iter_node]);
    tc_scope_exit();
    tc_prim(1)
}

// ---------- let / const (clones de typecheck_var_decl / const_decl) ----------
fn tc_var(node: i64) -> i64 {
    let nm = tc_decl_name(tree.text[node]);
    if tc_builtin(nm) {
        tc_err(node, "'" + nm + "' is a builtin and cannot be redeclared");
        return 1;
    }
    let annot = tc_child_labeled(node, "TypeIdent");
    let mut decl: i64 = 0;
    if annot != 0 {
        decl = tc_resolve_type(annot);
        if tcv_tps.kind[decl] == 17 { return 1; }
    }
    let mut init: i64 = 0;
    let first_c = tree.first[node];
    if first_c != 0 {
        if knames[tree.kind[first_c]] == "TypeIdent" {
            init = tree.next[first_c];
        } else {
            init = first_c;
        }
    }
    let mut vt: i64 = 0;
    if init != 0 {
        vt = tc_expr(init);
        if tc_is_error(tcv_tps.kind[vt]) { return 1; }
    }
    if vt != 0 && tcv_tps.kind[vt] == 1 {
        tc_err(node, "'" + nm + "' cannot be initialized with a void expression: this expression has no value to bind (a block has one only when it ends in an expression, not a statement)");
        return 1;
    }
    let mut final_t: i64 = 0;
    if decl != 0 && vt != 0 {
        if !tc_eq(decl, vt) {
            tc_err(node, "type mismatch: variable '" + nm + "' declared as " + tc_kname(tcv_tps.kind[decl]) + " but initialized with " + tc_kname(tcv_tps.kind[vt]));
        } else if tc_is_integer(tcv_tps.kind[decl]) && tc_lit_has_value(init) {
            let litv = tc_lit_value(init);
            if !tc_fits(litv, tcv_tps.kind[decl]) {
                tc_err(node, "integer literal " + to_string(litv) + " out of range for " + tc_kname(tcv_tps.kind[decl]));
            }
        }
        final_t = decl;
    } else if decl != 0 {
        final_t = decl;
    } else if vt != 0 {
        if tcv_tps.kind[vt] == 11 {
            final_t = tc_default_int(init);
        } else {
            final_t = vt;
        }
    } else {
        tc_err(node, "variable '" + nm + "' must have a type annotation or initializer");
        final_t = tc_prim(17);
    }
    tc_declare(nm, final_t, tc_is_mut_decl(tree.text[node]), false);
    return 1;
}

fn tc_const(node: i64) -> i64 {
    let nm = tc_decl_name(tree.text[node]);
    if tc_builtin(nm) {
        tc_err(node, "'" + nm + "' is a builtin and cannot be redeclared");
        return 1;
    }
    let annot = tc_child_labeled(node, "TypeIdent");
    let mut decl: i64 = 0;
    if annot != 0 {
        decl = tc_resolve_type(annot);
        if tcv_tps.kind[decl] == 17 { return 1; }
    }
    let mut init: i64 = 0;
    let first_c = tree.first[node];
    if first_c != 0 {
        if knames[tree.kind[first_c]] == "TypeIdent" {
            init = tree.next[first_c];
        } else {
            init = first_c;
        }
    }
    let mut vt: i64 = 0;
    if init != 0 {
        vt = tc_expr(init);
        if tc_is_error(tcv_tps.kind[vt]) { return 1; }
    }
    let mut final_t: i64 = 0;
    if decl != 0 && vt != 0 {
        if !tc_eq(decl, vt) {
            tc_err(node, "type mismatch: const '" + nm + "' declared as " + tc_kname(tcv_tps.kind[decl]) + " but initialized with " + tc_kname(tcv_tps.kind[vt]));
        } else if tc_is_integer(tcv_tps.kind[decl]) && tc_lit_has_value(init) {
            let litv = tc_lit_value(init);
            if !tc_fits(litv, tcv_tps.kind[decl]) {
                tc_err(node, "integer literal " + to_string(litv) + " out of range for " + tc_kname(tcv_tps.kind[decl]));
            }
        }
        final_t = decl;
    } else if decl != 0 {
        final_t = decl;
    } else if vt != 0 {
        if tcv_tps.kind[vt] == 11 {
            final_t = tc_default_int(init);
        } else {
            final_t = vt;
        }
    } else {
        tc_err(node, "const '" + nm + "' must have a type annotation or initializer");
        final_t = tc_prim(17);
    }
    tc_declare(nm, final_t, false, false);
    return 1;
}

// ---------- asignación (clon de typecheck_assign) ----------
fn tc_assign(node: i64) -> i64 {
    let target = tree.first[node];
    let value = tree.next[target];
    if target == 0 {
        tc_err(node, "assignment without a target");
        return tc_prim(17);
    }
    // `Color.Rojo = x` se parsea como acceso de campo sobre el nombre del
    // tipo: se rechaza ANTES de que el acceso lo tome por un valor válido
    if knames[tree.kind[target]] == "FieldAccess" {
        let obj = tc_expr(tree.first[target]);
        if tc_is_error(tcv_tps.kind[obj]) { return obj; }
        if tcv_tps.kind[obj] == 16 {
            tc_err(target, "cannot assign to enum variant '" + tcv_tps.s[obj] + "." + tc_payload(tree.text[target]) + "'");
            return tc_prim(17);
        }
    }
    // raíz LValue: bajar por FieldAccess/Index hasta el Ident
    let mut root = target;
    while true {
        let l = knames[tree.kind[root]];
        if l == "FieldAccess" {
            root = tree.first[root];
        } else if l == "Index" {
            root = tree.first[root];
        } else {
            break;
        }
    }
    if knames[tree.kind[root]] != "Ident" {
        tc_err(target, "invalid assignment target");
        return tc_prim(17);
    }
    let name = tc_decl_name(tree.text[root]);
    let i = tc_lookup(name);
    if i < 0 {
        tc_err(root, "undefined variable '" + name + "'");
        return tc_prim(17);
    }
    if tcv_syms.fns[i] {
        tc_err(root, "cannot reassign function '" + name + "'");
        return tc_prim(17);
    }
    if !tcv_syms.muts[i] {
        if knames[tree.kind[target]] != "Ident" {
            tc_err(root, "cannot assign through immutable variable '" + name + "' (declare it with 'let mut')");
        } else {
            tc_err(root, "cannot assign to immutable variable '" + name + "'");
        }
        return tc_prim(17);
    }
    // DEC-013: s[i] = … — receptor string
    if knames[tree.kind[target]] == "Index" {
        let objt = tc_expr(tree.first[target]);
        if tc_is_error(tcv_tps.kind[objt]) { return tc_prim(17); }
        if tcv_tps.kind[objt] == 8 {
            tc_err(target, "cannot assign to string element");
            return tc_prim(17);
        }
    }
    // tipo del lugar escrito (antes que el valor: orden del seed)
    let target_t = tc_expr(target);
    if tc_is_error(tcv_tps.kind[target_t]) { return tc_prim(17); }
    let vt = tc_expr(value);
    if tc_is_error(tcv_tps.kind[vt]) { return tc_prim(17); }
    if !tc_eq(vt, target_t) {
        let mut what = "variable";
        if knames[tree.kind[target]] == "Index" {
            what = "array element";
        } else if knames[tree.kind[target]] == "FieldAccess" {
            what = "struct field";
        }
        tc_err(node, "type mismatch: cannot assign " + tc_kname(tcv_tps.kind[vt]) + " to " + what + " of type " + tc_kname(tcv_tps.kind[target_t]));
    }
    target_t
}

// ---------- firma y cuerpo de fn ----------
fn tc_build_fn_type(node: i64) -> i64 {
    let fn_t = tc_mk(14);
    let mut first: i64 = 0;
    let mut prev: i64 = 0;
    let mut c = tree.first[node];
    while c != 0 {
        if knames[tree.kind[c]] == "Param" {
            let pt_node = tc_child_labeled(c, "TypeIdent");
            let mut pt: i64 = 10; // sin anotación -> unknown
            if pt_node != 0 {
                pt = tc_chain_node(tc_resolve_type(pt_node)); // clon si nominal
            }
            if prev == 0 {
                first = pt;
            } else {
                tcv_tps.nxt[prev] = pt;
            }
            prev = pt;
        }
        c = tree.next[c];
    }
    tcv_tps.a[fn_t] = first;
    let ret_node = tc_child_labeled(node, "ReturnType");
    if ret_node != 0 {
        let inner = tc_child_labeled(ret_node, "TypeIdent");
        if inner != 0 {
            let rr = tc_resolve_type(inner);
            tcv_tps.ret[fn_t] = rr;
        }
    }
    fn_t
}

fn tc_fn_body(node: i64) {
    let nm = tc_decl_name(tree.text[node]);
    tcv_gen = tcv_gen + 1;
    // parámetros: declarados con la generación de ESTA fn; un `self` sin
    // anotación en un método toma el tipo receptor (el seed sintetiza el
    // TypeIdent en el pass1 del impl — typechecker.c:3582)
    let mut c = tree.first[node];
    while c != 0 {
        if knames[tree.kind[c]] == "Param" {
            let pn = tc_decl_name(tree.text[c]);
            let pt_node = tc_child_labeled(c, "TypeIdent");
            let mut pt: i64 = 10;
            if pt_node != 0 {
                pt = tc_resolve_type(pt_node);
            } else if pn == "self" && tcv_recv != 0 {
                pt = tcv_recv;
            }
            tc_declare(pn, pt, false, false);
        }
        c = tree.next[c];
    }
    // retorno anotado
    let ret_node = tc_child_labeled(node, "ReturnType");
    tcv_ret = 0;
    if ret_node != 0 {
        let inner = tc_child_labeled(ret_node, "TypeIdent");
        if inner != 0 {
            tcv_ret = tc_resolve_type(inner);
        }
    }
    tcv_fndepth = tcv_fndepth + 1;
    let body = tc_child_labeled(node, "Block");
    tcv_contret = false;
    let mut body_t: i64 = tcv_void;
    if body != 0 {
        tcv_contret = tc_contains_return(body);
        body_t = tc_block_child(body);
    }
    // clon de typecheck_fn_body: sólo con retorno anotado real
    if tcv_ret != 0 && tcv_tps.kind[tcv_ret] != 1 && tcv_tps.kind[tcv_ret] != 17 && tcv_tps.kind[tcv_ret] != 10 {
        if tcv_tps.kind[body_t] != 1 {
            if !tc_eq(tcv_ret, body_t) {
                tc_err(node, "function '" + nm + "' returns " + tc_kname(tcv_tps.kind[tcv_ret]) + " but its body has type " + tc_kname(tcv_tps.kind[body_t]));
            }
        } else if !tcv_contret {
            tc_err(node, "function '" + nm + "' declares that it returns " + tc_kname(tcv_tps.kind[tcv_ret]) + " but its body produces no value: end the body with an expression without a trailing `;`, or add a `return`");
        }
    }
    tcv_fndepth = tcv_fndepth - 1;
    tcv_gen = tcv_gen - 1;
}

// ---------- módulo (clones de typecheck_module_pass / _body) ----------
fn tc_module(root: i64) {
    // pass 0a: nombres nominales (declare_type_decls) — los campos y
    // firmas pueden referenciarse en cualquier orden
    let mut c = tree.first[root];
    while c != 0 {
        let l = knames[tree.kind[c]];
        if l == "StructDecl" || l == "PubStructDecl" {
            let nm = tc_payload(tree.text[c]);
            let st = tc_mk(15);
            tcv_tps.s[st] = nm;
            tc_declare(nm, st, false, false);
        } else if l == "EnumDecl" || l == "PubEnumDecl" {
            let nm = tc_payload(tree.text[c]);
            let en = tc_mk(16);
            tcv_tps.s[en] = nm;
            tc_declare(nm, en, false, false);
        }
        c = tree.next[c];
    }
    // pass 0b: firmas de traits (collect_trait_decls), antes de los impls
    c = tree.first[root];
    while c != 0 {
        let l = knames[tree.kind[c]];
        if l == "Trait" || l == "PubTrait" {
            tc_collect_trait(c);
        }
        c = tree.next[c];
    }
    // pass 1: firmas de fn + fills nominales + impls, en orden de fuente
    c = tree.first[root];
    while c != 0 {
        let l = knames[tree.kind[c]];
        if l == "FnDecl" || l == "PubFnDecl" {
            let nm = tc_decl_name(tree.text[c]);
            if tc_builtin(nm) {
                tc_err(c, "'" + nm + "' is a builtin and cannot be redeclared");
            } else {
                let existing = tc_lookup(nm);
                if existing >= 0 && tcv_syms.fns[existing] {
                    tc_err(c, "duplicate function '" + nm + "'");
                }
                let fn_t = tc_build_fn_type(c);
                tc_declare(nm, fn_t, false, true);
            }
        } else if l == "StructDecl" || l == "PubStructDecl" {
            tc_struct_decl(c);
        } else if l == "EnumDecl" || l == "PubEnumDecl" {
            tc_enum_decl(c);
        } else if l == "Impl" {
            tc_impl(c);
        }
        c = tree.next[c];
    }
    // pass 2: cuerpos + items + sentencias de módulo en orden de fuente
    c = tree.first[root];
    while c != 0 {
        let l = knames[tree.kind[c]];
        if l == "FnDecl" || l == "PubFnDecl" {
            tc_fn_body(c);
        } else if l == "ConstDecl" || l == "PubConstDecl" {
            tc_const(c);
        } else if l == "VarDecl" {
            tc_var(c);
        } else if l == "Impl" {
            // cuerpos de los métodos ya registrados (typecheck_module_body)
            let mut recv: i64 = 0;
            let mut r: i64 = 1;
            while r < len(tcv_implnodes) {
                if tcv_implnodes[r] == c {
                    recv = tcv_implrecvs[r];
                }
                r = r + 1;
            }
            let saved_recv = tcv_recv;
            tcv_recv = recv;
            let mut m = tree.first[c];
            while m != 0 {
                let lm = knames[tree.kind[m]];
                if (lm == "FnDecl" || lm == "PubFnDecl") && tc_child_labeled(m, "Block") != 0 {
                    tc_fn_body(m);
                }
                m = tree.next[m];
            }
            tcv_recv = saved_recv;
        } else if l == "StructDecl" || l == "PubStructDecl" || l == "EnumDecl" || l == "PubEnumDecl" {
            // ya chequeados en el pass1 (re-los duplicaría cada
            // diagnóstico — audit §3.5)
        } else if l == "Use" || l == "Import" || l == "From" || l == "ImportItem" {
            // descartados en single-file (el seed no chequea nada)
        } else {
            tc_stmt(c);
        }
        c = tree.next[c];
    }
}

// ---------- init: builtins del seed (con sus firmas) ----------
fn tc_declare_builtin(name: string, arity: i64, p1: i64, ret_t: i64) {
    let fn_t = tc_mk(14);
    let mut first: i64 = 0;
    let mut prev: i64 = 0;
    let mut i: i64 = 0;
    while i < arity {
        let pt = tc_mk(p1);
        if prev == 0 {
            first = pt;
        } else {
            tcv_tps.nxt[prev] = pt;
        }
        prev = pt;
        i = i + 1;
    }
    tcv_tps.a[fn_t] = first;
    tcv_tps.ret[fn_t] = ret_t;
    tc_declare(name, fn_t, false, true);
}

fn tc_init() {
    tcv_void = tc_prim(1);
    tc_declare_builtin("print", 1, 10, tc_prim(1));
    tc_declare_builtin("len", 1, 10, tc_prim(4));
    tc_declare_builtin("to_string", 1, 10, tc_prim(8));
    tc_declare_builtin("read_file", 1, 8, tc_prim(8));
    tc_declare_builtin("ord", 1, 10, tc_prim(4));
    tc_declare_builtin("substr", 3, 10, tc_prim(8));
    tc_declare_builtin("push", 2, 10, tc_array(tc_prim(10)));
    tc_declare_builtin("str_to_int", 1, 10, tc_prim(4));
    tc_declare_builtin("chr", 1, 10, tc_prim(8));
    tc_declare_builtin("read_line", 0, 10, tc_prim(8));
    tc_declare_builtin("transfer", 1, 10, tc_prim(1));
    tc_declare_builtin("copy", 1, 10, tc_prim(10));
}

// ---------- driver ----------
fn main() {
    src = read_file("parser_input.astra");
    slen = len(src);
    pos = 0;
    has_look = false;
    cur_line = 1;
    nln = 1;
    t_line = 1;
    t_col = 1;
    prev_line = 1;
    prev_col = 1;
    prev_len = 0;
    line_start = 0;
    emit_guards = true;   // el checker necesita la guarda de cada Arm
    advance();
    let root = parse_module();
    if err_count > 0 {
        print("error: parse failed");
        return;
    }
    tc_init();
    tc_module(root);
    if tcv_errors > 0 {
        print("error: type check failed with " + to_string(tcv_errors) + " error(s)");
    }
}
