# Astra seed lexer/parser dictionary for libFuzzer (PHASE1_PROGRESS §4bis#23).
# Keywords come from the table in src/lexer.c; punctuation from the token
# kinds in include/astra/astra.h. Quotes and backslashes are escaped for the
# libFuzzer dictionary syntax.

# --- keywords (src/lexer.c) ---
kw_and="and"
kw_break="break"
kw_comptime="comptime"
kw_const="const"
kw_continue="continue"
kw_else="else"
kw_enum="enum"
kw_err="err"
kw_false="false"
kw_fn="fn"
kw_for="for"
kw_if="if"
kw_impl="impl"
kw_in="in"
kw_let="let"
kw_match="match"
kw_mod="mod"
kw_mut="mut"
kw_none="none"
kw_not="not"
kw_ok="ok"
kw_option="option"
kw_or="or"
kw_pub="pub"
kw_as="as"
kw_from="from"
kw_import="import"
kw_return="return"
kw_result="result"
kw_some="some"
kw_struct="struct"
kw_trait="trait"
kw_true="true"
kw_use="use"
kw_var="var"
kw_while="while"

# --- contextual type names (lexed as identifiers, but the typechecker
#     recognises them; worth feeding as units) ---
ty_i32="i32"
ty_i64="i64"
ty_u32="u32"
ty_u64="u64"
ty_f64="f64"
ty_string="string"
ty_bool="bool"

# --- operators and punctuation ---
op_plus="+"
op_minus="-"
op_star="*"
op_slash="/"
op_percent="%"
op_eq="=="
op_ne="!="
op_lt="<"
op_gt=">"
op_le="<="
op_ge=">="
op_andand="&&"
op_oror="||"
op_pipe="|"
op_amp="&"
op_caret="^"
op_shl="<<"
op_shr=">>"
op_dotdot=".."
op_dotdot_eq="..="
op_assign="="
op_not="!"
op_tilde="~"
op_dot="."
op_comma=","
op_semi=";"
op_colon=":"
op_coloncolon="::"
op_arrow="->"
op_fatarrow="=>"
op_question="?"
op_lparen="("
op_rparen=")"
op_lbracket="["
op_rbracket="]"
op_lbrace="{"
op_rbrace="}"

# --- literals ---
lit_0x="0x"
lit_0b="0b"
lit_0o="0o"
lit_exp="e"
lit_dot="0.0"
lit_str="\""
lit_comment="//"
