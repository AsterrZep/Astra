// Multi-module fixture: the dependency side of foreign aggregates. The
// importer constructs struct literals, enum values and match patterns from
// these declarations (PHASE2_PROGRESS §3).
pub struct Vec2 {
    x: f64
    y: f64
}

pub enum Shape {
    Circle(f64)
    Square(f64)
    Dot
}

pub fn circle(r: f64) -> Shape {
    Shape.Circle(r)
}

pub fn area(s: Shape) -> f64 {
    let a = match s {
        Shape.Circle(r) => 3.0 * r * r,
        Shape.Square(w) => w * w,
        Shape.Dot => 0.0,
    };
    a
}

pub const UNIT = Vec2 { x: 3.0, y: 4.0 }

pub const DOT = Shape.Dot;
