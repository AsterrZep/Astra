// Multi-module fixture root: struct literals, enum values and match patterns
// over types declared in `geometry` (foreign aggregates), both by `from`
// bindings (bare names) and through the `geo` namespace (`geo.Shape.Square`).
// Constants exported by `geometry` are read as values across the boundary:
// a struct value's fields (`UNIT.x`) and a match over an exported enum value.
from geometry import Vec2, Shape, circle, area, UNIT, DOT
import geometry as geo

fn main() {
    let v = Vec2 { x: 1.0, y: 2.0 };
    print(v.x + v.y);
    let s = circle(2.0);
    print(area(s));
    let n = match s {
        Shape.Circle(r) => 42,
        Shape.Square(w) => 0,
        Shape.Dot => 1,
    };
    print(n);
    let u = geo.Shape.Dot;
    let k = match u {
        Shape.Circle(r) => 0,
        Shape.Square(w) => 7,
        Shape.Dot => 3,
    };
    print(k);
    print(UNIT.x + UNIT.y);
    let d = DOT;
    let q = match d {
        Shape.Circle(r) => 1,
        Shape.Square(w) => 2,
        Shape.Dot => 99,
    };
    print(q);
}
