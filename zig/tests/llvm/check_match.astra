// Shape del `match` (LLVM_BACKEND_PLAN.md §6 M3): comparaciones encadenadas
// de variante (sin switch/hubs), GEP del payload por offset de slot, phi en
// el merge y trap noreturn para el fallthrough no cubierto.
//
// CHECK: define i64 @astra_fn_area
// CHECK: %[[OBJ:[0-9]+]] = load ptr, ptr
// CHECK: call i32 @astra_llvm_enum_eq(ptr %[[OBJ]], ptr getelementptr (
// CHECK: br i1 %{{[0-9]+}}, label %arm_bind, label %arm_next
// CHECK: match_merge:
// CHECK: phi i64
// CHECK: match_none:
// CHECK: call void @astra_llvm_fail(i32 37, ptr
// CHECK: unreachable
// CHECK: arm_next:
// CHECK: call i32 @astra_llvm_enum_eq(ptr %[[OBJ]], ptr getelementptr (
// CHECK: br i1 %{{[0-9]+}}, label %arm_bind2, label %arm_next1
// CHECK: arm_bind:
// CHECK: getelementptr i8, ptr %[[OBJ]], i64 16
// CHECK: arm_next1:
// CHECK: call i32 @astra_llvm_enum_eq(ptr %[[OBJ]], ptr getelementptr (
// CHECK: br i1 %{{[0-9]+}}, label %arm_bind5, label %arm_next4
// CHECK: arm_bind2:
// CHECK: getelementptr i8, ptr %[[OBJ]], i64 16
// CHECK: getelementptr i8, ptr %[[OBJ]], i64 24
// CHECK: arm_next4:
// CHECK: br label %match_none
// CHECK: arm_body6:
// CHECK: br label %match_merge

enum Shape {
    Circle(i32)
    Rect(i32, i32)
    Empty
}

fn area(s: Shape) -> i32 {
    match s {
        Shape.Circle(r) => 3 * r * r,
        Shape.Rect(w, h) => w * h,
        Shape.Empty => 0,
    }
}

fn main() {
    print(area(Shape.Circle(2)))
    print(area(Shape.Rect(3, 4)))
    print(area(Shape.Empty))
}
