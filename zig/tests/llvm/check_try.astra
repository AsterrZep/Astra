// Shape de `?` (M6.c etapa c.1, LLVM_BACKEND_PLAN.md §6): el retorno
// `i32?` es el par `{ i8 tag; i64 payload }` en SSA — `?` extrae el tag sin
// heap (err=1 o none=3 desvían a `try_err`, que devuelve el par tal cual),
// el camino ok extrae el payload del campo 1. Sin longjmp. El lowering a
// caja (`astra_llvm_wrap`) ocurre sólo en la frontera de `print`.
//
// CHECK: define { i8, i64 } @astra_fn_half
// CHECK: define { i8, i64 } @astra_fn_quarter
// CHECK: %[[PAIR:[0-9]+]] = call { i8, i64 } @astra_fn_half(ptr null, i64
// CHECK: %[[TAG:[0-9]+]] = extractvalue { i8, i64 } %[[PAIR]], 0
// CHECK: %[[ISERR:[0-9]+]] = icmp eq i8 %[[TAG]], 1
// CHECK: %[[ISNONE:[0-9]+]] = icmp eq i8 %[[TAG]], 3
// CHECK: %[[BAD:[0-9]+]] = or i1 %[[ISERR]], %[[ISNONE]]
// CHECK: br i1 %[[BAD]], label %try_err, label %try_ok, !prof
// CHECK: try_err:
// CHECK: ret { i8, i64 } %[[PAIR]]
// CHECK: try_ok:
// CHECK: %[[PAY:[0-9]+]] = extractvalue { i8, i64 } %[[PAIR]], 1
// CHECK: insertvalue { i8, i64 } { i8 2, i64 undef }, i64
// CHECK: define void @astra_fn_main
// CHECK: %[[R:[0-9]+]] = call { i8, i64 } @astra_fn_quarter
// CHECK: %[[PTAG:[0-9]+]] = extractvalue { i8, i64 } %[[R]], 0
// CHECK: icmp eq i8 %[[PTAG]], 3
// CHECK: br i1 {{.*}}, label %pair_none, label %pair_wrap
// CHECK: pair_wrap:
// CHECK: call ptr @astra_llvm_wrap(
// CHECK: call void @astra_llvm_print_boxed(

fn half(x: i32) -> i32? {
    if x % 2 != 0 { return none }
    some(x / 2)
}

fn quarter(x: i32) -> i32? {
    let h = half(x)?
    some(h / 2)
}

fn main() {
    print(quarter(8))
    print(quarter(9))
}
