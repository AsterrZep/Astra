// Benchmark: enum construction + match with payload bindings in a loop (M4).
enum Op {
    Add(i32)
    Mul(i32)
    Neg
}

fn apply(op: Op, acc: i32) -> i32 {
    match op {
        Op.Add(v) => acc + v,
        Op.Mul(v) => acc * v,
        Op.Neg => -acc,
    }
}

fn main() {
    let mut i: i32 = 0
    let mut acc: i32 = 1
    while i < 1000000 {
        acc = apply(Add(i % 13), acc)
        acc = apply(Mul(2), acc)
        if i % 97 == 0 {
            acc = apply(Op.Neg, acc)
        }
        i = i + 1
    }
    print(acc)
}
