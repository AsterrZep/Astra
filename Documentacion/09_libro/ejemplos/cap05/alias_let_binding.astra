// `let` protects the BINDING, not the object: q is a mutable alias of the
// same struct p points at, so q.x = 5 is visible through p.
struct P { x: i32 }

fn main() {
    let p = P { x: 1 };        // immutable binding
    let mut q = p;             // mutable alias to the SAME object
    q.x = 5;
    print(p.x);
    print(q.x);
}
