// Writing a field of a `let mut` struct, including a chained field/index.
struct Punto {
    x: i32
    y: i32
}

struct Matriz {
    fila: [i32]
    alto: i32
}

fn main() {
    let mut p = Punto { x: 1, y: 2 };
    p.x = 5;
    print(p.x);

    let mut m = Matriz { fila: [7, 8], alto: 2 };
    m.fila[1] = 99;
    print(m.fila[1]);
    print(m.fila[0]);
}
