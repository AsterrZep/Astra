// Astra Language Evolution — Phase 1 (Seed Compiler)
// Features: variables, arithmetic, strings, print
// Backend: VM + C codegen (--emit-c)
// Status: ✅ Working (89/89 tests pass)

fn main() {
    // --- Integer types ---
    let x = 42;
    let y = 8;
    print(x + y);       // 50
    print(x - y);       // 34
    print(x * y);       // 336
    print(x / y);       // 5
    print(x % y);       // 2

    // --- Float types ---
    let pi = 3.14159;
    let e = 2.71828;
    print(pi + e);      // 5.85987
    print(pi * 2.0);    // 6.28318

    // --- Boolean type ---
    print(true);        // true
    print(false);       // false

    // --- String type ---
    let greeting = "Hello, Astra!";
    print(greeting);

    // --- String concatenation ---
    let first = "Astra";
    let second = " Language";
    print(first + second);   // Astra Language

    // --- Comparisons ---
    print(5 > 3);       // true
    print(5 == 5);      // true
    print(5 != 3);      // true
    print(5 <= 5);      // true
    print(5 >= 3);      // true

    // --- Logical operators (short-circuit) ---
    let and_result = true && false;
    let or_result = true || false;
    print(and_result);   // false
    print(or_result);    // true

    // --- Bitwise operators ---
    print(5 & 3);       // 1
    print(5 | 3);       // 7
    print(5 ^ 3);       // 6
    print(1 << 10);     // 1024
    print(1024 >> 3);   // 128

    // --- Unary minus ---
    let neg = -42;
    print(neg);
    print(-neg);

    // --- Integer width types (i64, u32) ---
    let big: i64 = 9999999999;
    let small: u32 = 4294967295;
    print(big);
    print(small);
}
